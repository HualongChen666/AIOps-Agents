# API Configuration
# Leave NEXT_PUBLIC_API_BASE empty so every call is same-origin and goes through
# the Next.js /api/:path* rewrite. That keeps the HttpOnly session cookie
# first-party (no CORS credential juggling) and avoids exposing secrets.
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# Server-side only (NOT prefixed with NEXT_PUBLIC_ so it never reaches the
# browser bundle). Used by app/api/guard/** and app/api/v1/approvals/** to
# reach backend endpoints that require X-Internal-Key. Must match the backend
# INTERNAL_API_KEY.
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY

# Server-side only: origin of the FastAPI backend used by the proxy handlers.
BACKEND_URL=http://127.0.0.1:8000

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false

# Development Settings
NEXT_PUBLIC_DEV_MODE=true
NEXT_PUBLIC_LOG_LEVEL=debug
