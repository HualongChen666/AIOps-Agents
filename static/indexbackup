    /**
     * 🔧 M-3 阶段 2:更新指定主机节点的状态(灰度→点亮的核心)
     * 🔧 BUG-FIX-4:用 data-metric-type 属性选择器更新数值,更稳定
     */
    function setHostNodeState(hostId, newState, metrics) {
        var validStates = ['idle', 'active', 'running', 'warning', 'critical', 'symptom'];
        if (validStates.indexOf(newState) === -1) {
            console.warn('[M-3 阶段2] 无效的节点状态:', newState);
            return;
        }

        _hostNodeStates[hostId] = newState;

        var nodeEl = document.querySelector('.host-node[data-host-id="' + hostId + '"]');
        if (!nodeEl) return;

        nodeEl.setAttribute('data-state', newState);

        // 更新数值
        if (metrics) {
            if (metrics.cpu !== undefined) {
                var cpuEl = nodeEl.querySelector('[data-metric-type="cpu"]');
                if (cpuEl) {
                    cpuEl.textContent = metrics.cpu + (typeof metrics.cpu === 'number' ? '%' : '');
                    cpuEl.className = '';
                    if (typeof metrics.cpu === 'number') {
                        if (metrics.cpu >= 90) cpuEl.className = 'value-critical';
                        else if (metrics.cpu >= 70) cpuEl.className = 'value-warn';
                    }
                }
            }
            if (metrics.mem !== undefined) {
                var memEl = nodeEl.querySelector('[data-metric-type="mem"]');
                if (memEl) {
                    memEl.textContent = metrics.mem + (typeof metrics.mem === 'number' ? '%' : '');
                    memEl.className = '';
                    if (typeof metrics.mem === 'number') {
                        if (metrics.mem >= 90) memEl.className = 'value-critical';
                        else if (metrics.mem >= 70) memEl.className = 'value-warn';
                    }
                }
            }
        }

        // 状态切换为 critical 时,需要重新渲染以显示根因徽章
        if (newState === 'critical' && nodeEl.querySelectorAll('.root-cause').length === 0) {
            renderFullLinkCanvas();
        }

        updateFullLinkStatusBar();
    }

    /**
     * 🔧 M-3 阶段 2:更新底部状态栏统计
     */
    function updateFullLinkStatusBar() {
        var healthy = 0, warning = 0, critical = 0, total = 0;

        ['tier1', 'tier2', 'tier3', 'tier4', 'tier5'].forEach(function(tk) {
            var nodes = _MOCK_HOST_NODES[tk] || [];
            nodes.forEach(function(node) {
                if (node.virtual) return;
                total++;
                var state = _hostNodeStates[node.id] || 'idle';
                if (state === 'critical') critical++;
                else if (state === 'warning' || state === 'symptom') warning++;
                else if (state === 'running' || state === 'active') healthy++;
            });
        });

        function setText(id, val) {
            var el = document.getElementById(id);
            if (el) el.textContent = val;
        }

        setText('status-healthy-count', healthy);
        setText('status-warning-count', warning);
        setText('status-critical-count', critical);
        setText('status-total-count', total);
        setText('status-last-update', new Date().toLocaleTimeString('zh-CN', { hour12: false }));
    }

