    // 完整数据流关系映射
    const TOPO_EDGES = [
        { from: 'topo-node-infra',       to: 'topo-node-collect' },
        { from: 'topo-node-os',          to: 'topo-node-collect' },
        { from: 'topo-node-collect',     to: 'topo-node-awareness' },
        { from: 'topo-node-awareness',   to: 'topo-node-event' },
        { from: 'topo-node-event',       to: 'topo-node-pass' },
        { from: 'topo-node-event',       to: 'topo-node-hw_issue' },
        { from: 'topo-node-event',       to: 'topo-node-sw_issue' },
        { from: 'topo-node-hw_issue',    to: 'topo-node-auto_repair' },
        { from: 'topo-node-auto_repair', to: 'topo-node-dtdd' },
        { from: 'topo-node-dtdd',        to: 'topo-node-memory' },
        { from: 'topo-node-sw_issue',    to: 'topo-node-rca' },
        { from: 'topo-node-rca',         to: 'topo-node-auto_fix' },
        { from: 'topo-node-auto_fix',    to: 'topo-node-memory' },
        { from: 'topo-node-auto_fix',    to: 'topo-node-sandbox' },
        { from: 'topo-node-sandbox',     to: 'topo-node-manual' },
        { from: 'topo-node-sandbox',     to: 'topo-node-auto_fix' }, // 回流
        { from: 'topo-node-manual',      to: 'topo-node-memory' },
        { from: 'topo-node-memory',      to: 'topo-node-awareness' }, // 大回流
