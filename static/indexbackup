            let icon, color;
            if (health >= 90)      { icon = '🟢'; color = '#00e676'; }
            else if (health >= 70) { icon = '🟡'; color = '#ffd740'; }
            else                   { icon = '🔴'; color = '#ff5252'; }
            badge.textContent = `${icon} 整体健康度 ${health}%`;
            badge.style.color = color;
        }
    }
