        popup.querySelector('.sp-cpu-canvas-slot').replaceWith(cpuCanvas);
        popup.querySelector('.sp-mem-canvas-slot').replaceWith(memCanvas);

        document.body.appendChild(popup);

        // 定位:节点右侧
        const rect = card.getBoundingClientRect();
        popup.style.left = (rect.right + 12) + 'px';
        popup.style.top  = (rect.top + rect.height / 2 - popup.offsetHeight / 2) + 'px';

        // 防止超出右边界
        requestAnimationFrame(function() {
            const popupRect = popup.getBoundingClientRect();
            if (popupRect.right > window.innerWidth - 12) {
                popup.style.left = (rect.left - popupRect.width - 12) + 'px';
            }
            popup.classList.add('visible');
        });

        // 用闭包变量保存引用
        window._m3p5.sparklinePopup = popup;
        window._m3p5.sparklineCanvases = { cpu: cpuCanvas, mem: memCanvas };

        // 拉取历史数据并绘制
        try {
