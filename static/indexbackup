    /**
     * 🔧 M-3 阶段 2:渲染整个全链路拓扑画布
     */
    async function renderFullLinkCanvas() {
        const container = document.getElementById('topo-view-full-link');
        if (!container) {
            console.warn('[M-3 阶段4] 容器 topo-view-full-link 不存在');
            return;
        }

        container.innerHTML = '<div style="text-align:center;padding:40px;color:#0ff;">⏳ 正在加载全链路拓扑(因果传播)...</div>';

        try {
            // 1. 拉取后端数据
            const resp = await fetch('/api/topology/full-link');
            if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
            const data = await resp.json();

            if (!data.nodes || data.nodes.length === 0) {
                container.innerHTML = `
                    <div style="text-align:center;padding:40px;color:#888;">
                        📭 暂无主机数据<br>
                        <small>请在 .env 中配置 LINUX_HOST_N_IP 等参数</small>
                    </div>
                `;
                return;
            }

            // 2. 清空 + 容器定位
            container.innerHTML = '';
            container.style.position = 'relative';

            // 3. SVG 边层(z-index 在节点下方)
            const svgNS = 'http://www.w3.org/2000/svg';
            const svgEdges = document.createElementNS(svgNS, 'svg');
            svgEdges.setAttribute('class', 'full-link-edges');
            svgEdges.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:1;';
            container.appendChild(svgEdges);

            // 4. SVG 粒子层(z-index 高于边层)
            const svgParticles = document.createElementNS(svgNS, 'svg');
            svgParticles.setAttribute('class', 'full-link-particles');
            svgParticles.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:3;';
            container.appendChild(svgParticles);

            // 5. 按 layer 分组节点
            const layerMap = {};
            data.nodes.forEach(n => {
                const lv = n.layer ?? 99;
                if (!layerMap[lv]) layerMap[lv] = [];
                layerMap[lv].push(n);
            });

            // 6. 分层渲染节点
            const layerKeys = Object.keys(layerMap).sort((a, b) => Number(a) - Number(b));
            layerKeys.forEach(layer => {
                const layerDiv = document.createElement('div');
                layerDiv.className = 'topo-layer';
                layerDiv.style.cssText = `
                    position: relative;
                    display: flex;
                    justify-content: center;
                    gap: 24px;
                    margin: 24px 0;
                    z-index: 2;
                    flex-wrap: wrap;
                `;

                layerMap[layer].forEach(node => {
                    // 复用 M-3 阶段 2 的 renderHostNode(返回 HTML 字符串)
                    var metrics = {
                        cpu: (typeof node.cpu === 'number') ? node.cpu : '--',
                        mem: (typeof node.mem === 'number') ? node.mem : '--'
                    };
                    var nodeForRender = {
                        id:      node.id,
                        name:    node.name,
                        icon:    node.icon || '🖥️',
                        role:    node.role_name || node.role || '',
                        virtual: (node.role === 'internet')
                    };
                    var html = renderHostNode(nodeForRender, node.state || 'idle', metrics);

                    var wrapper = document.createElement('div');
                    wrapper.innerHTML = html.trim();
                    var card = wrapper.firstElementChild;

                    if (!card) {
                        console.warn('[M-3 阶段4] 节点渲染失败:', node);
                        return;
                    }

                    card.dataset.nodeId = node.id;

                    // 🔧 M-3 阶段5:绑定 hover Sparkline + 点击时间线
                    if (typeof bindNodeHoverSparkline === 'function') {
                        bindNodeHoverSparkline(card, node);
                    }
                    if (typeof bindNodeClickTimeline === 'function') {
                        bindNodeClickTimeline(card, node);
                    }
                    // 🔧 BUG-FIX-3:仅在节点本身没有 position 时设置(避免覆盖现有样式)
                    const computedPos = window.getComputedStyle(card).position;
                    if (computedPos === 'static' || !computedPos) {
                        card.style.position = 'relative';
                    }

                    // 🔧 BUG-FIX-4+8:根因徽章已由 renderHostNode 内置(状态=critical 时显示)
                    //                这里仅为 symptom 节点单独添加外层徽章(不重复加根因)
                    if (node.is_symptom && !node.is_root_cause) {
                        const badge = document.createElement('span');
                        badge.className = 'symptom-badge-overlay';
                        badge.textContent = '⚠️ 症状';
                        card.appendChild(badge);
                    }

                    layerDiv.appendChild(card);
                });

                container.appendChild(layerDiv);
            });

            // 7. 等待布局完成,绘制边和粒子
            requestAnimationFrame(() => {
                const positions = {};
                container.querySelectorAll('[data-node-id]').forEach(card => {
                    positions[card.dataset.nodeId] = {
                        x: card.offsetLeft + card.offsetWidth / 2,
                        y: card.offsetTop + card.offsetHeight / 2,
                    };
                });

                // 8. 绘制每条边 + 对应粒子
                data.edges.forEach((edge, edgeIdx) => {
                    const from = positions[edge.from];
                    const to = positions[edge.to];
                    if (!from || !to) {
                        console.warn(`[M-3 阶段4] 边坐标缺失: ${edge.from} → ${edge.to}`);
                        return;
                    }

                    const state = edge.state || 'normal';

                    // ── 8.1 绘制路径(贝塞尔曲线)──
                    const path = document.createElementNS(svgNS, 'path');
                    const midY = (from.y + to.y) / 2;
                    const d = `M ${from.x} ${from.y} C ${from.x} ${midY}, ${to.x} ${midY}, ${to.x} ${to.y}`;
                    path.setAttribute('d', d);
                    path.setAttribute('data-edge-state', state);   // 🔧 BUG-FIX-5:用 data-edge-state
                    path.setAttribute('stroke-dasharray', '6,4');
                    path.setAttribute('fill', 'none');
                    path.style.animation = 'dashFlow 1.5s linear infinite';
                    svgEdges.appendChild(path);

                    // ── 8.2 绘制粒子(根据状态决定数量)──
                    const particleConfig = {
                        normal:     { count: 1, radius: 3, duration: 2.5 },
                        root_cause: { count: 3, radius: 5, duration: 1.2 },
                        symptom:    { count: 2, radius: 4, duration: 1.8 },
                        healing:    { count: 2, radius: 4, duration: 1.5 },
                    };
                    const cfg = particleConfig[state] || particleConfig.normal;

                    for (let i = 0; i < cfg.count; i++) {
                        const circle = document.createElementNS(svgNS, 'circle');
                        circle.setAttribute('r', cfg.radius);
                        circle.setAttribute('cx', 0);
                        circle.setAttribute('cy', 0);
                        circle.setAttribute('data-edge-state', state);

                        // CSS Motion Path:让粒子沿贝塞尔曲线流动
                        // 兼容性:Chrome ≥79 / Edge ≥79 / Firefox ≥72 / Safari ≥16
                        circle.style.offsetPath = `path("${d}")`;
                        circle.style.offsetRotate = '0deg';
                        circle.style.animation = `particleFlow ${cfg.duration}s linear infinite`;
                        circle.style.animationDelay = `${(i * cfg.duration / cfg.count).toFixed(2)}s`;

                        svgParticles.appendChild(circle);
                    }
                });

                console.log(
                    `[M-3 阶段4] 因果传播渲染完成 | ` +
                    `节点=${data.nodes.length} | 边=${data.edges.length} | ` +
                    `根因=${data.causal_summary?.root_count ?? 0} | ` +
                    `症状=${data.causal_summary?.symptom_count ?? 0} | ` +
                    `自愈=${data.causal_summary?.healing_count ?? 0}`
                );
            });

            // 9. 更新底部状态栏(复用 M-3 阶段 2 已有函数)
            if (typeof updateFullLinkStatusBar === 'function') {
                updateFullLinkStatusBar(data.stats, data.updated_at);
            }
            // 10. 更新因果摘要徽章
            updateCausalSummaryBar(data.causal_summary || {});

        } catch (e) {
            console.error('[M-3 阶段4] 全链路拓扑加载失败:', e);
            container.innerHTML = `
                <div style="text-align:center;padding:40px;color:#ff6b6b;">
                    ⚠️ 加载失败: ${e.message}<br>
                    <small style="color:#888;margin-top:8px;display:inline-block;">
                        请检查 /api/topology/full-link 接口和后端日志
                    </small>
                </div>
            `;
        }
    }

