    function updatePipelineHealth(stats) {
        const noise = parseFloat(stats.noise_reduction_rate) || 70;
        const detect = parseFloat(stats.detect_precision) || 90;
        const rca = parseFloat(stats.rca_accuracy) || 85;
        const heal = parseFloat(stats.heal_rate) || 0;

        const health = Math.round(noise * 0.2 + detect * 0.25 + rca * 0.3 + heal * 0.25);

        const badge = document.getElementById('pl-health-badge');
