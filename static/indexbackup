    // 基础设施页面
    // ============================================================
    async function loadInfraLinux() {
        const hostData = await fetchAPI('/api/linux/hosts');
        const container = document.getElementById('infra-linux-container');
        if (!container) return;

        if (!hostData || !hostData.hosts || hostData.hosts.length === 0) {
            container.innerHTML = `<div class="empty-state">
                🐧 未配置 Linux 主机<br>
                <small>请在 .env 中配置 LINUX_HOST_1_IP 等参数</small>
            </div>`;
            setText('mini-linux-hosts', '主机 0 台');
            const dot = document.getElementById('mini-linux-dot');
            if (dot) { dot.classList.remove('green'); dot.classList.add('gray'); }
            return;
        }

        setText('mini-linux-hosts', `主机 ${hostData.total} 台`);
        const dot = document.getElementById('mini-linux-dot');
        if (dot) { dot.classList.remove('gray'); dot.classList.add('green'); }

        // 拉取指标
        const metricsData = await fetchAPI('/api/linux/collect/all');
        const metricsMap = {};
        if (metricsData && metricsData.hosts) {
            metricsData.hosts.forEach(h => { metricsMap[h.name || h.host] = h; });
        }

        container.innerHTML = hostData.hosts.map(host => {
            const m = metricsMap[host.name] || {};
            const metrics = m.metrics || {};

            const cpuParsed = metrics.cpu_usage && metrics.cpu_usage.parsed;
            const cpuVal = cpuParsed ? cpuParsed.usage_percent + '%' : '--';

            const memParsed = metrics.memory && metrics.memory.parsed;
            const memVal = memParsed ? memParsed.usage_percent + '%' : '--';

            const statusIcon = m.status === 'ok' ? '🟢' :
                              m.status === 'degraded' ? '🟡' : '🔴';

            return `<div class="linux-host-card">
                <div class="host-header">
                    <span class="host-status">${statusIcon}</span>
                    <span class="host-name">${escapeHTML(host.name)}</span>
                    <span class="host-ip">${escapeHTML(host.host)}</span>
                </div>
                <div class="host-metrics">
                    <span>CPU ${cpuVal}</span>
                    <span>内存 ${memVal}</span>
                    <span>认证 ${escapeHTML(host.auth)}</span>
                </div>
                <details>
                    <summary>📋 查看详细指标 JSON</summary>
                    <pre class="json-detail">${escapeHTML(JSON.stringify(metrics, null, 2))}</pre>
                </details>
            </div>`;
        }).join('');

        // 更新 Linux 微缩 CPU 均值
        if (metricsData && metricsData.hosts) {
            const cpuValues = metricsData.hosts
                .map(h => h.metrics && h.metrics.cpu_usage && h.metrics.cpu_usage.parsed && h.metrics.cpu_usage.parsed.usage_percent)
                .filter(v => v !== undefined && v !== null);
            if (cpuValues.length > 0) {
                const avgCpu = (cpuValues.reduce((a, b) => a + b, 0) / cpuValues.length).toFixed(1);
                setText('mini-linux-cpu', `CPU ${avgCpu}%`);
            }
        }
    }

