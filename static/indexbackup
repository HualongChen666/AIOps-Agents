    function updateProgressBar(fillId, textId, percent) {
        const fill = document.getElementById(fillId);
        const text = document.getElementById(textId);
        if (!fill || !text) return;

        // 确保百分比在 0-100 之间
        const val = Math.max(0, Math.min(100, parseFloat(percent) || 0));

        // 更新宽度和文字
        fill.style.width = val + '%';
        text.textContent = val.toFixed(1) + '%';

        // 移除旧的颜色类
        fill.classList.remove('progress-green', 'progress-orange', 'progress-red');
        text.classList.remove('progress-text-green', 'progress-text-orange', 'progress-text-red');

        // 🔧 N-3 核心逻辑：三色判定
        if (val >= 90) {
            fill.classList.add('progress-green');
            text.classList.add('progress-text-green');
        } else if (val >= 70) {
            fill.classList.add('progress-orange');
            text.classList.add('progress-text-orange');
        } else {
            fill.classList.add('progress-red');
            text.classList.add('progress-text-red');
        }
    }

    function updatePipelineFromStats(stats) {
        if (!stats) return;

        // ═══ 统一提取核心变量，确保卡片、进度条、KPI 使用同一数据源 ═══
        const ingestRate   = stats.ingestion_rate || '100K';
        const noiseRate    = stats.noise_reduction_rate ?? stats.noise_reduction ?? 0;
        const anomalyCount = stats.current_anomalies ?? 0;
        const detectPrecision = stats.detect_precision ?? '--';
        const rcaAcc       = stats.rca_accuracy ?? 0;
        const healRate     = stats.heal_rate ?? 0;

        // ═══ 卡片 1：数据采集与摄入 ═══
        const ingestEl = document.getElementById('pl-card-ingestion-value');
        if (ingestEl) ingestEl.textContent = ingestRate;

        // ═══ 卡片 2：告警降噪 ═══
        const noiseEl = document.getElementById('pl-card-noise-value');
        if (noiseEl) noiseEl.textContent = noiseRate;

        // 降噪详情：原始→有效告警、压缩比
        // 🔧 BUG-FIX-2：去掉 Math.max(1, ...)，允许 effectiveAlerts 为 0
        const totalAlerts = stats.total_alerts || 0;
        const effectiveAlerts = Math.round(totalAlerts * (1 - noiseRate / 100));
        const noiseRaw = document.getElementById('pl-card-raw-alerts');
        if (noiseRaw) noiseRaw.textContent = totalAlerts + ' → ' + effectiveAlerts;

        // 🔧 BUG-FIX-3：分母为 0 或总数为 0 时显示 "--"
        const noiseRatio = document.getElementById('pl-card-compress-ratio');
        if (noiseRatio) {
            if (totalAlerts > 0 && effectiveAlerts > 0) {
                noiseRatio.textContent = Math.round(totalAlerts / effectiveAlerts) + ' : 1';
            } else {
                noiseRatio.textContent = '--';
            }
        }

        // ═══ 卡片 3：异常检测 ═══
        const anomalyEl = document.getElementById('pl-card-anomalies-value');
        if (anomalyEl) anomalyEl.textContent = anomalyCount;
        const precisionEl = document.getElementById('pl-card-detect-precision');
        if (precisionEl) precisionEl.textContent = detectPrecision + ' %';
        const mttdEl = document.getElementById('pl-card-mttd-value');
        if (mttdEl) mttdEl.textContent = (stats.mttd ?? '--') + ' min';

        // ═══ 卡片 4：根因分析 RCA ═══
        const rcaEl = document.getElementById('pl-card-rca-value');
        if (rcaEl) rcaEl.textContent = rcaAcc;

        // ═══ 卡片 5：自动修复 ═══
        const healEl = document.getElementById('pl-card-heal-value');
        if (healEl) healEl.textContent = healRate;
        const repairsEl = document.getElementById('pl-card-repairs-today');
        if (repairsEl) repairsEl.textContent = (stats.auto_fixed ?? stats.resolved ?? 0) + ' 次';
        const mttrEl = document.getElementById('pl-card-mttr-value');
        if (mttrEl) mttrEl.textContent = (stats.mttr ?? '--') + ' min';

        // ═══ 🔧 N-3：进度条动态颜色回填 ═══
        const collectRate = 99.2;
        updateProgressBar('pl-progress-collect', 'pl-progress-text-collect', collectRate);
        updateProgressBar('pl-progress-noise',   'pl-progress-text-noise',   parseFloat(noiseRate) || 0);
        updateProgressBar('pl-progress-detect',  'pl-progress-text-detect',  parseFloat(detectPrecision) || 0);
        updateProgressBar('pl-progress-rca',     'pl-progress-text-rca',     parseFloat(rcaAcc) || 0);
        updateProgressBar('pl-progress-heal',    'pl-progress-text-heal',    parseFloat(healRate) || 0);

        // ═══ 顶部 KPI 统计条回填（🔧 BUG-FIX-4：统一使用顶部提取的变量）═══
        const kpiIngestion = document.getElementById('pl-kpi-ingestion');
        if (kpiIngestion) kpiIngestion.textContent = ingestRate;
        const kpiNoise = document.getElementById('pl-kpi-noise');
        if (kpiNoise) kpiNoise.textContent = noiseRate + '%';
        const kpiAnomalies = document.getElementById('pl-kpi-anomalies');
        if (kpiAnomalies) kpiAnomalies.textContent = anomalyCount;
        const kpiRca = document.getElementById('pl-kpi-rca');
        if (kpiRca) kpiRca.textContent = rcaAcc + '%';
        const kpiHeal = document.getElementById('pl-kpi-heal');
        if (kpiHeal) kpiHeal.textContent = healRate + '%';

        // 🔧 BUG-FIX-5：存在性检查
        if (typeof addPipelineLog === 'function') {
            addPipelineLog('INFO', '流水线卡片数据已从真实 API 刷新');
        }
    }

    function updatePipelineAlertStats(alertData) {
        const total = alertData.total || 0;
        const alerts = alertData.alerts || [];
        const effective = alerts.filter(a => a.level === 'critical' || a.level === 'warning').length;
        const ratio = total > 0 ? Math.round(total / Math.max(effective, 1)) : 0;

        setText('pl-card-raw-alerts', total + ' → ' + effective);
        setText('pl-card-compress-ratio', ratio + ':1');
    }

