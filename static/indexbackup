            const oldCard = document.getElementById('ai-analysis-card');
            if (oldCard) oldCard.remove();

            const loadingCard = document.createElement('div');
            loadingCard.id = 'ai-analysis-card';
            loadingCard.className = 'drawer-metric-card';
            loadingCard.style.cssText = 'grid-column: 1 / -1; border-left: 3px solid #06b6d4;';
            loadingCard.innerHTML = `
                <div class="dm-label">🤖 AI 深度分析</div>
                <div class="dm-value" style="font-size: 12px; font-weight: normal; color: rgba(255,255,255,0.6);">
                    ⏳ 正在采集富上下文（进程 / 告警 / 修复历史）并请求 AI 分析...
                </div>
