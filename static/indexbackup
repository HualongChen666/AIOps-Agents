    async function handleDeepAnalysis() {
        addPipelineLog('INFO', '正在发起 AI 深度分析请求...');

        // 🔧 BUG-FIX-1：使用可选链 + trim()，避免取到换行/空白
        const stageName = document.getElementById('drawer-name')?.textContent?.trim() || '未知阶段';

        // 🔧 BUG-FIX-2：自动识别平台，避免 Windows 调用对 Linux 主机分析时输出错误命令
        const platform = navigator.platform.toLowerCase().includes('win') ? 'windows' : 'linux';

        // 🔧 BUG-FIX-3：防止用户连点造成多次 API 调用
        const btn = document.querySelector('.drawer-footer button:last-child');
        if (btn && btn.dataset.aiLoading === '1') {
            addPipelineLog('WARN', 'AI 分析正在进行中，请勿重复点击');
            return;
        }
        if (btn) {
            btn.dataset.aiLoading = '1';
            btn.textContent = '⏳ 分析中...';
        }

        // 🔧 BUG-FIX-4：先在 detailGrid 中显示 loading 占位，告诉用户系统正在工作
        const detailGrid = document.getElementById('drawer-detail-grid');
        if (detailGrid) {
