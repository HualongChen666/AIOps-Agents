     * 🔧 M-3 阶段5:显示节点时间线浮窗
     * BUG-FIX-7:用闭包变量持有 events/summary 元素
     */
    async function showNodeTimeline(node) {
        closeNodeTimeline();

        const modal = document.createElement('div');
        modal.className = 'node-timeline-modal';

        // 用 createElement 而非 innerHTML,便于直接持有引用
        modal.innerHTML = `
            <div class="node-timeline-content">
                <div class="node-timeline-header">
                    <div class="node-timeline-title">
                        🕐 节点时间线: ${_m3p5EscapeHTML(node.name || node.id)}
                    </div>
                    <button class="node-timeline-close" type="button">✕</button>
                </div>
                <div class="node-timeline-summary">⏳ 加载中...</div>
                <div class="node-timeline-events">
                    <div style="text-align:center;padding:40px;color:#888;">
                        ⏳ 正在加载时间线...
                    </div>
                </div>
            </div>
        `;

        document.body.appendChild(modal);
        requestAnimationFrame(function() {
            modal.classList.add('visible');
        });

        // 闭包持有引用
        const summaryEl = modal.querySelector('.node-timeline-summary');
        const eventsEl  = modal.querySelector('.node-timeline-events');
        const closeBtn  = modal.querySelector('.node-timeline-close');

        window._m3p5.timelineModal     = modal;
        window._m3p5.timelineEventsEl  = eventsEl;
        window._m3p5.timelineSummaryEl = summaryEl;

        // 关闭按钮事件
        closeBtn.addEventListener('click', closeNodeTimeline);

        // 点击背景关闭
        modal.addEventListener('click', function(e) {
            if (e.target === modal) closeNodeTimeline();
        });

        // ESC 键关闭
        const escHandler = function(e) {
            if (e.key === 'Escape') {
                closeNodeTimeline();
                document.removeEventListener('keydown', escHandler);
            }
        };
        document.addEventListener('keydown', escHandler);

        // 拉取时间线数据
        try {
            const url = `/api/topology/node/${encodeURIComponent(node.id)}/timeline?hours=24&limit=50`;
            const resp = await fetch(url);
            if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
            const data = await resp.json();

            // 模态框可能已被关闭
            if (window._m3p5.timelineModal !== modal) return;

            // 渲染摘要
            const s = data.summary || {};
            summaryEl.innerHTML = `
                <span>📋 总计: ${s.total ?? 0}</span>
                <span>🚨 告警: ${s.alerts ?? 0}</span>
                <span>🔧 修复: ${s.repairs ?? 0}</span>
                <span style="margin-left:auto;color:#888;">最近 24 小时</span>
            `;

            // 渲染事件列表
            const events = data.events || [];
            if (events.length === 0) {
                eventsEl.innerHTML = '<div style="text-align:center;padding:40px;color:#888;">📭 暂无事件</div>';
            } else {
                eventsEl.innerHTML = events.map(function(ev) {
                    return `
                        <div class="timeline-event level-${_m3p5EscapeHTML(ev.level || 'info')}">
                            <div class="timeline-event-icon">${ev.icon || '📌'}</div>
                            <div class="timeline-event-body">
                                <div class="timeline-event-time">${_m3p5EscapeHTML(ev.time || '')}</div>
                                <div class="timeline-event-title">${_m3p5EscapeHTML(ev.title || '')}</div>
                                <div class="timeline-event-desc">${_m3p5EscapeHTML(ev.desc || '')}</div>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            console.log(`[M-3 阶段5] 时间线加载完成 | node=${node.id} | 事件=${events.length}`);

        } catch (e) {
            console.error('[M-3 阶段5] 时间线加载失败:', e);
            if (window._m3p5.timelineModal === modal) {
                eventsEl.innerHTML = `
                    <div style="text-align:center;padding:40px;color:#ff6b7a;">
                        ⚠️ 加载失败: ${_m3p5EscapeHTML(e.message)}
                    </div>
                `;
            }
        }
    }

