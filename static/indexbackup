    async function refreshPipelineData() {
        let statsOk   = false;
        let alertsOk  = false;
        let pendingOk = false;

        // ═══ 1. 并行请求三个 API ═══
        try {
            const [statsRes, alertsRes, pendingRes] = await Promise.all([
                fetch('/api/stats/summary').catch(e => { console.warn('stats 请求失败:', e); return null; }),
                fetch('/api/alerts/?limit=50').catch(e => { console.warn('alerts 请求失败:', e); return null; }),
                fetch('/api/autoheal/pending').catch(e => { console.warn('pending 请求失败:', e); return null; })
            ]);

            // ═══ 2. Stats 数据处理（含兜底）═══
            if (statsRes && statsRes.ok) {
                try {
                    const stats = await statsRes.json();
                    _lastGoodStats = stats;  // ✅ 缓存成功数据
                    statsOk = true;
                    updatePipelineFromStats(stats);
                    updatePipelineHealth(stats);
                } catch (parseErr) {
                    console.warn('stats JSON 解析失败:', parseErr);
                }
            }
            if (!statsOk && _lastGoodStats) {
                // ✅ P0-2 兜底：使用上一次成功的缓存数据
                updatePipelineFromStats(_lastGoodStats);
                updatePipelineHealth(_lastGoodStats);
                addPipelineLog('WARN', 'Stats API 请求失败，已使用缓存数据兜底');
            } else if (!statsOk && !_lastGoodStats) {
                addPipelineLog('ERROR', 'Stats API 请求失败且无缓存，卡片数据无法更新');
            }

            // ═══ 3. Alerts 数据处理（含兜底）═══
            if (alertsRes && alertsRes.ok) {
                try {
                    const alerts = await alertsRes.json();
                    _lastGoodAlerts = alerts;  // ✅ 缓存成功数据
                    alertsOk = true;
                    updatePipelineAlertStats(alerts);
                } catch (parseErr) {
                    console.warn('alerts JSON 解析失败:', parseErr);
                }
            }
            if (!alertsOk && _lastGoodAlerts) {
                updatePipelineAlertStats(_lastGoodAlerts);
                addPipelineLog('WARN', 'Alerts API 请求失败，已使用缓存数据兜底');
            }

            // ═══ 4. Pending 数据处理（含兜底）═══
            if (pendingRes && pendingRes.ok) {
                try {
                    const pending = await pendingRes.json();
                    _lastGoodPending = pending;  // ✅ 缓存成功数据
                    pendingOk = true;
                    updatePipelinePending(pending);
                } catch (parseErr) {
                    console.warn('pending JSON 解析失败:', parseErr);
                }
            }
            if (!pendingOk && _lastGoodPending) {
                updatePipelinePending(_lastGoodPending);
                addPipelineLog('WARN', 'Pending API 请求失败，已使用缓存数据兜底');
            }

            // ═══ 5. 刷新完成日志 ═══
            if (statsOk && alertsOk && pendingOk) {
                addPipelineLog('INFO', '流水线数据刷新完成');
            } else if (statsOk || alertsOk || pendingOk) {
                addPipelineLog('WARN', '流水线数据部分刷新成功，部分使用缓存兜底');
            }

        } catch (e) {
            // ═══ 6. 全局异常兜底 ═══
            console.error('流水线数据刷新整体异常:', e);
            addPipelineLog('ERROR', '数据刷新异常: ' + e.message);

            // 即使整体异常，仍然尝试用缓存回填
            if (_lastGoodStats) {
                updatePipelineFromStats(_lastGoodStats);
                updatePipelineHealth(_lastGoodStats);
            }
            if (_lastGoodAlerts) {
                updatePipelineAlertStats(_lastGoodAlerts);
            }
            if (_lastGoodPending) {
                updatePipelinePending(_lastGoodPending);
            }
            if (_lastGoodStats || _lastGoodAlerts || _lastGoodPending) {
                addPipelineLog('WARN', '已使用全部缓存数据兜底，请检查后端服务状态');
            }
        }
    }

