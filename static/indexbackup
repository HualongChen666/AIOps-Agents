     * 每条日志 DOM 元素增加 data-level 属性，用于过滤
     */
    function addPipelineLog(level, msg) {
        // 查找日志滚动容器（优先用新 id，降级到原有容器）
        const container = document.getElementById('pipeline-log-scroll')
                    || document.querySelector('.pipeline-log-area')
