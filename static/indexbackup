    function openDrilldown(stage) {
        const config = DRILLDOWN_CONFIG[stage];
        if (!config) return;

        // 🔧 N-6：保存当前 stage 标记，防止竞态条件
        // 用户快速切换抽屉时，旧请求的回调不会污染新抽屉内容
        const _drawerOpenToken = stage + '_' + Date.now();
        window._currentDrawerToken = _drawerOpenToken;

        setText('drawer-icon', config.icon);
        setText('drawer-name', config.name);
        setText('drawer-desc', config.desc);

        // ═══ 核心指标 ═══
        const metricsGrid = document.getElementById('drawer-metrics-grid');
        if (metricsGrid) {
            metricsGrid.innerHTML = config.metrics.map(m => {
                let val = m.value || '--';
                // 🔧 BUG-FIX-1：lastPipelineStats 可能未初始化，加 typeof 保护
                if (m.key && typeof lastPipelineStats !== 'undefined' && lastPipelineStats) {
                    const v = lastPipelineStats[m.key];
                    if (v != null) val = v + (m.unit || '');
                }
                return `<div class="drawer-metric-card">
                    <div class="dm-label">${escapeHTML(m.label)}</div>
                    <div class="dm-value">${escapeHTML(String(val))}</div>
                </div>`;
            }).join('');
        }

        // ═══ 详细参数 ═══
        const detailGrid = document.getElementById('drawer-detail-grid');
        if (detailGrid) {
            // 🔧 N-6：为容器打上当前 stage 标记，防止异步回调跨抽屉污染
            detailGrid.setAttribute('data-current-stage', stage);

            detailGrid.innerHTML = (config.details || []).map(d => `
                <div class="drawer-metric-card">
                    <div class="dm-label">${escapeHTML(d.label)}</div>
                    <div class="dm-value">${escapeHTML(String(d.value || '--'))}</div>
                </div>
            `).join('');
        }

        // ═══ 显示抽屉 ═══
        const overlay = document.getElementById('drilldown-overlay');
        const drawer = document.getElementById('drilldown-drawer');
        if (overlay) overlay.classList.add('open');
        setTimeout(() => { if (drawer) drawer.classList.add('open'); }, 10);

        // ═══ 自动修复抽屉：主动拉取待审批数据 ═══
        if (stage === 'heal') {
            fetch('/api/autoheal/pending')
                .then(r => {
                    // 🔧 BUG-FIX-2：原生 fetch 不会因 HTTP 4xx/5xx 进入 .catch
                    // 必须手动检查 r.ok
                    if (!r.ok) throw new Error(`HTTP ${r.status}`);
                    return r.json();
                })
                .then(pendingData => {
                    // 🔧 N-6：检查抽屉上下文是否仍为 'heal'，防止竞态污染
                    const currentDetailGrid = document.getElementById('drawer-detail-grid');
                    if (!currentDetailGrid ||
                        currentDetailGrid.getAttribute('data-current-stage') !== 'heal') {
                        return;
                    }

                    const items = pendingData.items || [];
                    const count = pendingData.total || items.length || 0;

                    let pendingHtml = '';
                    if (count > 0) {
                        pendingHtml = items.map(item => `
                            <div class="drawer-metric-card" style="grid-column: 1 / -1; border-left: 3px solid #FF9100;">
                                <div class="dm-label">⏳ ${escapeHTML(item.rule || '未知规则')}</div>
                                <div class="dm-value" style="font-size: 12px; font-weight: normal; white-space: pre-wrap; line-height: 1.5; color: rgba(255,255,255,0.8);">
                                    ${escapeHTML(item.proposal || '暂无方案详情')}
                                </div>
                                <button onclick="event.stopPropagation(); approveFromDrawer('${escapeHTML(String(item.alert_id))}')" 
                                        style="margin-top: 8px; padding: 6px 16px; background: #00E676; color: #000; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">
                                    ✅ 审批通过并执行
                                </button>
                            </div>
                        `).join('');
                    } else {
                        pendingHtml = `
                            <div class="drawer-metric-card" style="grid-column: 1 / -1;">
                                <div class="dm-label">待审批方案</div>
                                <div class="dm-value" style="color: #00E676;">✅ 当前无待审批项</div>
                            </div>
                        `;
                    }
                    currentDetailGrid.innerHTML += pendingHtml;
                })
                .catch(err => {
                    console.warn('拉取待审批数据失败:', err);
                    if (typeof addPipelineLog === 'function') {
                        addPipelineLog('WARN', '待审批数据拉取失败: ' + err.message);
                    }
                    // 🔧 BUG-FIX-3：失败时给予 UI 反馈，而不仅是 console
                    const currentDetailGrid = document.getElementById('drawer-detail-grid');
                    if (currentDetailGrid &&
                        currentDetailGrid.getAttribute('data-current-stage') === 'heal') {
                        currentDetailGrid.innerHTML += `
                            <div class="drawer-metric-card" style="grid-column: 1 / -1; border-left: 3px solid #FF1744;">
                                <div class="dm-label">获取待审批方案失败</div>
                                <div class="dm-value" style="color: #FF1744;">❌ ${escapeHTML(err.message)}</div>
                            </div>
                        `;
                    }
                });
        }

        // ═══ 🔧 N-6：抽屉打开后加载迷你趋势图 ═══
        // setTimeout 延迟 50ms 确保抽屉 DOM 已可见，Canvas 能正确获取尺寸
        setTimeout(() => {
            if (typeof loadDrawerSparklines === 'function') {
                loadDrawerSparklines();
            }
        }, 50);

        if (typeof addPipelineLog === 'function') {
            addPipelineLog('INFO', `打开下钻详情: ${config.name}`);
        }
    }

