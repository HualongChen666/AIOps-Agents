<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AIOps Agent Dashboard</title>
    <style>
        /* ══════════════════════════════════════════════════════════════
           CSS 变量与全局样式（完全不变）
           ══════════════════════════════════════════════════════════════ */
        :root {
            --bg-primary: #0a0e1a;
            --bg-secondary: #111827;
            --bg-card: #1a1f35;
            --bg-card-hover: #242b45;
            --border-color: rgba(255,255,255,0.06);
            --text-primary: #e2e8f0;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --accent-blue: #3b82f6;
            --accent-cyan: #06b6d4;
            --accent-green: #10b981;
            --accent-red: #ef4444;
            --accent-yellow: #f59e0b;
            --accent-purple: #8b5cf6;
            --accent-orange: #f97316;
            --accent-magenta: #ec4899;
            --glow-blue: rgba(59,130,246,0.15);
            --glow-cyan: rgba(6,182,212,0.15);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* ═══ 顶部导航栏 ═══ */
        .top-nav {
            height: 48px;
            background: linear-gradient(135deg, #0f1629 0%, #1a1040 100%);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            padding: 0 20px;
            gap: 8px;
            flex-shrink: 0;
            z-index: 100;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-right: 32px;
        }

        .nav-brand .logo {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .nav-brand span {
            font-size: 16px;
            font-weight: 700;
            background: linear-gradient(90deg, var(--accent-cyan), var(--accent-blue));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-tabs {
            display: flex;
            gap: 4px;
        }

        .nav-tab {
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 13px;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.2s;
            border: 1px solid transparent;
            background: transparent;
        }

        .nav-tab:hover {
            color: var(--text-primary);
            background: rgba(255,255,255,0.05);
        }

        .nav-tab.active {
            color: var(--accent-cyan);
            background: rgba(6,182,212,0.1);
            border-color: rgba(6,182,212,0.3);
        }

        .nav-status {
            margin-left: auto;
            font-size: 12px;
            color: var(--text-muted);
        }

        /* ═══ 页面容器 ═══ */
        .page-container {
            flex: 1;
            overflow: hidden;
        }

        .page {
            display: none;
            height: 100%;
            overflow: hidden;
        }

        .page.active { display: flex; flex-direction: column; }

        /* ═══════════════════════════════════════════════════════
           总览页样式
           ═══════════════════════════════════════════════════════ */
        .dashboard-grid {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto auto 1fr;
            gap: 12px;
            padding: 12px;
            overflow: hidden;
        }

        /* KPI 卡片行 */
        .kpi-row {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: repeat(4, 1fr); /* 强制平分为4等份 */
            gap: 12px;
        }

        .kpi-card {
            flex: 1;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.3s;
        }

        .kpi-card:hover {
            background: var(--bg-card-hover);
            border-color: rgba(6,182,212,0.2);
            transform: translateY(-1px);
        }

        .kpi-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .kpi-icon.alerts { background: linear-gradient(135deg, rgba(239,68,68,0.2), rgba(239,68,68,0.05)); }
        .kpi-icon.resolved { background: linear-gradient(135deg, rgba(16,185,129,0.2), rgba(16,185,129,0.05)); }
        .kpi-icon.mttd { background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(59,130,246,0.05)); }
        .kpi-icon.accuracy { background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(139,92,246,0.05)); }

        .kpi-content { flex: 1; min-width: 0; }

        .kpi-number {
            font-size: 26px;
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -0.5px;
        }

        .kpi-label {
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 2px;
        }

        .kpi-trend {
            font-size: 11px;
            margin-top: 2px;
        }

        .kpi-trend.positive { color: var(--accent-green); }
        .kpi-trend.negative { color: var(--accent-red); }

        /* 仪表盘 + 微缩状态行 */
        .gauge-row {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: repeat(4, 1fr); /* 强制与第一排的4等份完全一致 */
            gap: 12px;
            align-items: stretch;
        }
        .gauge-group {
            display: contents; /* 关键魔法：让包裹的3个仪表盘直接参与上一级的网格划分 */
        }

        .gauge-card {
            flex: 1;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .gauge-ring {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .gauge-ring::before {
            content: '';
            position: absolute;
            inset: 3px;
            border-radius: 50%;
            background: var(--bg-card);
        }

        .gauge-value {
            position: relative;
            z-index: 1;
            font-size: 15px;
            font-weight: 700;
        }

        .gauge-label {
            font-size: 11px;
            color: var(--text-secondary);
            text-align: center;
        }

        .mini-status-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            /* 原本这里有一个 min-width: 180px，删掉它让它自然填满第4个网格 */
        }

        .mini-status-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 8px 12px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
        }

        .mini-status-card .platform-icon {
            font-size: 16px;
        }

        .mini-status-card .platform-name {
            font-weight: 600;
            min-width: 55px;
        }

        .mini-status-card .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .mini-status-card .status-dot.green { background: var(--accent-green); box-shadow: 0 0 6px var(--accent-green); }
        .mini-status-card .status-dot.gray { background: var(--text-muted); }
        .mini-status-card .status-dot.blue { background: var(--accent-blue); box-shadow: 0 0 6px var(--accent-blue); }

        .mini-status-card .metrics {
            display: flex;
            gap: 8px;
            color: var(--text-muted);
            font-size: 11px;
        }

        /* 待审批横幅 */
        .pending-banner {
            grid-column: 1 / -1;
            background: linear-gradient(90deg, rgba(245,158,11,0.1), rgba(245,158,11,0.03));
            border: 1px solid rgba(245,158,11,0.25);
            border-radius: 8px;
            padding: 8px 16px;
            display: none;
            align-items: center;
            gap: 10px;
            font-size: 13px;
        }

        .pending-banner.show { display: flex; }

        .pending-banner .pending-icon { font-size: 16px; }
        .pending-banner .pending-text { flex: 1; color: var(--accent-yellow); }
        .pending-banner .pending-action {
            color: var(--accent-cyan);
            cursor: pointer;
            font-size: 12px;
        }

        /* 下半区:趋势图 + 告警 + 修复 */
        .dashboard-bottom {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: repeat(3, 1fr); /* 强制平分为3等份 */
            gap: 12px;
            min-height: 0;
            flex: 1;
        }

        /* 趋势图区域 */
        .chart-panel {
            /* 删除了原来的 flex: 1.2 */
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            min-width: 0; /* 防止内部图表撑破等宽限制 */
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .chart-title {
            font-size: 13px;
            font-weight: 600;
        }

        .chart-body {
            flex: 1;
            display: flex;
            gap: 12px;
            min-height: 0;
        }

        .chart-canvas-wrap {
            flex: 1;
            position: relative;
        }

        .chart-canvas-wrap canvas {
            width: 100% !important;
            height: 100% !important;
        }

        .chart-sidebar {
            width: 140px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            font-size: 11px;
        }

        .chart-sidebar .sidebar-title {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-secondary);
            padding-bottom: 4px;
            border-bottom: 1px solid var(--border-color);
        }

        .chart-sidebar .res-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 4px 0;
        }

        .chart-sidebar .res-item .res-label {
            color: var(--text-muted);
        }

        .chart-sidebar .res-item .res-value {
            font-weight: 600;
            font-family: 'SF Mono', 'Cascadia Code', monospace;
        }

        /* 告警列表 */
        .alert-panel {
            /* 删除了原来的 flex: 0.8 */
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .alert-panel-title {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .alert-list {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .alert-item {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            padding: 6px 8px;
            border-radius: 6px;
            background: rgba(255,255,255,0.02);
            font-size: 12px;
            transition: background 0.2s;
        }

        .alert-item:hover { background: rgba(255,255,255,0.05); }

        .alert-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            margin-top: 5px;
            flex-shrink: 0;
        }

        .alert-dot.critical { background: var(--accent-red); box-shadow: 0 0 6px var(--accent-red); }
        .alert-dot.warning { background: var(--accent-yellow); box-shadow: 0 0 6px var(--accent-yellow); }
        .alert-dot.info { background: var(--accent-blue); }

        .alert-content { flex: 1; min-width: 0; }

        .alert-title {
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .alert-desc {
            display: block;
            color: var(--text-muted);
            font-size: 11px;
            margin-top: 1px;
        }

        .alert-time {
            font-size: 11px;
            color: var(--text-muted);
            white-space: nowrap;
            flex-shrink: 0;
        }

        /* 修复动态 */
        .repair-panel {
            /* 删除了原来的 flex: 0.6 */
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .repair-panel-title {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .repair-list {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .repair-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 8px;
            border-radius: 6px;
            background: rgba(255,255,255,0.02);
            font-size: 12px;
        }

        .repair-item .repair-icon { font-size: 14px; flex-shrink: 0; }

        .repair-item .repair-title {
            flex: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .repair-item .repair-time {
            color: var(--text-muted);
            font-size: 11px;
            flex-shrink: 0;
        }

        .empty-state {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: var(--text-muted);
            font-size: 12px;
            text-align: center;
            padding: 16px;
        }

        /* ═══════════════════════════════════════════════════════
           工作流页面样式
           ═══════════════════════════════════════════════════════ */
        .workflow-page {
            height: 100%;
            overflow: hidden;
        }
        .page.active.workflow-page {
            display: flex;
            flex-direction: row;
        }

        .wf-left {
            flex: 6;
            display: flex;
            flex-direction: column;
            padding: 16px;
            gap: 12px;
            border-right: 1px solid var(--border-color);
        }

        .wf-right {
            flex: 4;
            display: flex;
            flex-direction: column;
            padding: 16px;
            gap: 12px;
            overflow-y: auto;
        }

        /* 工作流选择器 */
        .wf-selector {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .wf-btn {
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 12px;
            cursor: pointer;
            border: 1px solid var(--border-color);
            background: var(--bg-card);
            color: var(--text-secondary);
            transition: all 0.2s;
        }

        .wf-btn:hover {
            border-color: var(--accent-cyan);
            color: var(--text-primary);
        }

        .wf-btn.active {
            background: rgba(6,182,212,0.15);
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
        }

        /* 工作流控制 */
        .wf-controls {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .wf-run-btn, .wf-reset-btn {
            padding: 6px 16px;
            border-radius: 8px;
            font-size: 12px;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
        }

        .wf-run-btn {
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
            color: white;
            font-weight: 600;
        }

        .wf-run-btn:hover { opacity: 0.9; transform: translateY(-1px); }

        .wf-reset-btn {
            background: var(--bg-card);
            color: var(--text-secondary);
            border: 1px solid var(--border-color);
        }

        .wf-status {
            margin-left: auto;
            font-size: 12px;
            color: var(--text-muted);
        }

        /* 工作流节点链 */
        .wf-chain {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 4px;
            overflow-y: auto;
            padding-right: 4px;
        }

        .wf-title-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            background: rgba(6,182,212,0.05);
            border: 1px solid rgba(6,182,212,0.15);
            border-radius: 8px;
            margin-bottom: 4px;
        }

        .wf-title-icon { font-size: 18px; }

        .wf-title-text {
            font-size: 14px;
            font-weight: 600;
        }

        .wf-title-desc {
            font-size: 11px;
            color: var(--text-muted);
            margin-left: auto;
        }

        .wf-node {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            transition: all 0.4s;
            position: relative;
            overflow: hidden;
        }

        .wf-node::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: var(--text-muted);
            border-radius: 3px 0 0 3px;
            transition: all 0.4s;
        }

        .wf-node.running::before { background: var(--accent-cyan); box-shadow: 0 0 12px var(--accent-cyan); }
        .wf-node.done::before { background: var(--accent-green); }
        .wf-node.warn::before { background: var(--accent-yellow); }

        .wf-node.running {
            border-color: rgba(6,182,212,0.3);
            background: rgba(6,182,212,0.05);
        }

        .wf-node.done {
            border-color: rgba(16,185,129,0.2);
        }

        .wf-node-index {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
            flex-shrink: 0;
        }

        .wf-node.done .wf-node-index { background: rgba(16,185,129,0.15); color: var(--accent-green); }
        .wf-node.running .wf-node-index { background: rgba(6,182,212,0.15); color: var(--accent-cyan); }

        .wf-node-info { flex: 1; }

        .wf-node-title {
            font-size: 13px;
            font-weight: 600;
        }

        .wf-node-desc {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 1px;
        }

        .wf-node-duration {
            font-size: 11px;
            color: var(--text-muted);
            font-family: 'SF Mono', monospace;
        }

        /* 工作流右侧面板 */
        .wf-info-section {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 14px;
        }

        .wf-info-title {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .wf-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .wf-info-item {
            padding: 8px 10px;
            background: rgba(255,255,255,0.03);
            border-radius: 6px;
        }

        .wf-info-item .info-label {
            font-size: 11px;
            color: var(--text-muted);
        }

        .wf-info-item .info-value {
            font-size: 16px;
            font-weight: 700;
            margin-top: 2px;
        }

        /* 待审批区域 */
        .wf-pending-section {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 14px;
        }

        .wf-pending-title {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--accent-red);
        }

        .wf-pending-count {
            margin-left: auto;
            font-size: 11px;
            color: var(--text-muted);
        }

        .wf-pending-list {
            max-height: 200px;
            overflow-y: auto;
        }

        .pending-item {
            padding: 8px 10px;
            background: rgba(255,255,255,0.03);
            border-radius: 6px;
            margin-bottom: 6px;
        }

        .pending-rule {
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .pending-proposal {
            font-size: 11px;
            color: var(--text-muted);
            margin-bottom: 6px;
            line-height: 1.4;
        }

        .pending-actions {
            display: flex;
            gap: 6px;
        }

        .btn-approve, .btn-reject {
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 11px;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
        }

        .btn-approve {
            background: rgba(16,185,129,0.15);
            color: var(--accent-green);
        }

        .btn-approve:hover { background: rgba(16,185,129,0.3); }

        .btn-reject {
            background: rgba(239,68,68,0.15);
            color: var(--accent-red);
        }

        .btn-reject:hover { background: rgba(239,68,68,0.3); }

        /* 工作流日志 */
        .wf-log {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 14px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .wf-log-title {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }

        .wf-log-content {
            flex: 1;
            overflow-y: auto;
            font-family: 'SF Mono', 'Cascadia Code', monospace;
            font-size: 11px;
            line-height: 1.6;
            color: var(--text-muted);
        }

        .wf-log-content .log-line {
            padding: 1px 0;
        }

        .wf-log-content .log-time { color: var(--text-muted); }
        .wf-log-content .log-info { color: var(--accent-cyan); }
        .wf-log-content .log-success { color: var(--accent-green); }
        .wf-log-content .log-warn { color: var(--accent-yellow); }
        .wf-log-content .log-error { color: var(--accent-red); }

        /* ═══════════════════════════════════════════════════════
           拓扑页面样式（完全不动）
           ═══════════════════════════════════════════════════════ */
        .topo-page {
            /* 您原有的其他样式保留 */
           /* display: flex; */
           /*  flex-direction: column; */
            height: 100%;
            overflow: hidden;
        }

        .topo-header {
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            border-bottom: 1px solid var(--border-color);
            flex-shrink: 0;
        }

        .topo-title {
            font-size: 15px;
            font-weight: 600;
        }

        .topo-subtitle {
            font-size: 12px;
            color: var(--text-muted);
        }

        .topo-actions {
            margin-left: auto;
            display: flex;
            gap: 8px;
        }

        .topo-btn {
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 12px;
            cursor: pointer;
            border: 1px solid var(--border-color);
            background: var(--bg-card);
            color: var(--text-secondary);
            transition: all 0.2s;
        }

        .topo-btn.primary {
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
            border: none;
            color: white;
            font-weight: 600;
        }

        .topo-btn.primary:hover { opacity: 0.9; }
        .topo-btn.danger { border-color: rgba(239,68,68,0.3); color: var(--accent-red); }

        .topo-body {
            width: 100%;
            height: 100%;               /* 🔧 增加显式高度兜底 */
            position: relative; 
        }

        /* 拓扑节点 */
        .topo-node {
            position: absolute;
            padding: 10px 14px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            cursor: default;
            transition: all 0.3s;
            z-index: 10;
            min-width: 130px;
            text-align: center;
        }

        .topo-node:hover {
            border-color: rgba(6,182,212,0.3);
            transform: scale(1.03);
            z-index: 20;
        }

        .topo-node .node-badge {
            position: absolute;
            top: -6px;
            right: -6px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            font-size: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--bg-primary);
        }

        .topo-node .node-badge.hub { background: var(--accent-cyan); color: white; }
        .topo-node .node-badge.dell { background: #0076CE; color: white; }
        .topo-node .node-badge.brain { background: var(--accent-purple); color: white; }
        .topo-node .node-badge.sec { background: var(--accent-green); color: white; }

        .topo-node .node-icon {
            font-size: 22px;
            margin-bottom: 4px;
        }

        .topo-node .node-name {
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .topo-node .node-desc {
            font-size: 10px;
            color: var(--text-muted);
            white-space: nowrap;
        }

        /* 拓扑节点颜色 */
        /* 拓扑节点颜色与专属底色 */
        .topo-node.layer-infra { 
            border-color: rgba(6,182,212,0.6); 
            background: rgba(6,182,212,0.15) !important; 
        }
        .topo-node.layer-collect { 
            border-color: rgba(59,130,246,0.6); 
            background: rgba(59,130,246,0.15) !important; 
        }
        .topo-node.layer-analyze { 
            border-color: rgba(139,92,246,0.6); 
            background: rgba(139,92,246,0.15) !important; 
        }
        .topo-node.layer-action { 
            border-color: rgba(16,185,129,0.6); 
            background: rgba(16,185,129,0.15) !important; 
        }
        .topo-node.layer-knowledge { 
            border-color: rgba(245,158,11,0.6); 
            background: rgba(245,158,11,0.15) !important; 
        }

        .topo-node.active {
            border-color: rgba(6,182,212,0.5);
            box-shadow: 0 0 20px rgba(6,182,212,0.15);
        }

        .topo-node.active .node-icon { animation: nodePulse 2s infinite; }

        @keyframes nodePulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        /* AIOps Agent 专属区域框的呼吸动画 */
        @keyframes agentBoxBreathe {
            0% { 
                border-color: rgba(6, 182, 212, 0.2); 
                background: rgba(6, 182, 212, 0.02);
            }
            100% { 
                border-color: rgba(6, 182, 212, 0.8); 
                background: rgba(6, 182, 212, 0.08);
            }
        }

        /* 新增：拓扑连线的一明一暗呼吸动画 */
        .topo-edge {
            animation: edgeBreathe 1.5s infinite alternate ease-in-out;
        }

        @keyframes edgeBreathe {
            0% { stroke-opacity: 0.2; }
            100% { stroke-opacity: 1; }
        }

        /* SVG 连线层 */
        .topo-svg-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 5;
        }

        /* ═══════════════════════════════════════════════════════
           流水线页面样式
           ═══════════════════════════════════════════════════════ */
        .pipeline-page {
            height: 100%;
            overflow: hidden;
        }
        .page.active.pipeline-page {
            display: flex;
            flex-direction: column;
        }

        .pipeline-header {
            padding: 12px 20px 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .pipeline-title {
            font-size: 15px;
            font-weight: 700;
        }

        .pipeline-subtitle {
            font-size: 11px;
            color: var(--text-muted);
        }

        .pipeline-health-badge {
            margin-left: auto;
            font-size: 13px;
            font-weight: 600;
        }

        .pipeline-refresh-btn {
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 11px;
            cursor: pointer;
            border: 1px solid var(--border-color);
            background: var(--bg-card);
            color: var(--text-secondary);
            transition: all 0.2s;
        }

        .pipeline-refresh-btn:hover {
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
        }

        .pipeline-refresh-btn.loading {
            opacity: 0.6;
            pointer-events: none;
        }

        /* KPI 统计条 */
        .pipeline-kpi-bar {
            display: flex;
            gap: 2px;
            padding: 0 20px 8px;
            flex-shrink: 0;
        }

        .pipeline-kpi-item {
            flex: 1;
            padding: 6px 10px;
            border-radius: 6px;
            text-align: center;
            font-size: 11px;
        }

        .pipeline-kpi-item .kpi-val {
            font-size: 16px;
            font-weight: 800;
            font-family: 'SF Mono', monospace;
        }

        .pipeline-kpi-item .kpi-lbl {
            font-size: 10px;
            opacity: 0.8;
            margin-top: 1px;
        }

        .pipeline-kpi-item:nth-child(1) { background: rgba(6,182,212,0.1); color: var(--accent-cyan); }
        .pipeline-kpi-item:nth-child(2) { background: rgba(59,130,246,0.1); color: var(--accent-blue); }
        .pipeline-kpi-item:nth-child(3) { background: rgba(249,115,22,0.1); color: var(--accent-orange); }
        .pipeline-kpi-item:nth-child(4) { background: rgba(239,68,68,0.1); color: var(--accent-red); }
        .pipeline-kpi-item:nth-child(5) { background: rgba(236,72,153,0.1); color: var(--accent-magenta); }

        /* ============================================================
        🔧 N-3：进度条动态颜色（绿/橙/红）+ 百分比文本
        ============================================================ */

        /* 进度条容器：改为 flex 布局，让百分比文本显示在旁边 */
        .pipeline-progress-wrapper {
            display: flex;
            align-items: center;
            gap: 8px;
            width: 100%;
        }

        /* 进度条轨道 */
        .pipeline-progress-track {
            flex-grow: 1;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 4px;
            height: 8px;
            overflow: hidden;
        }

        /* 进度条填充 */
        .pipeline-progress-fill {
            height: 100%;
            width: 0%;
            border-radius: 4px;
            transition: width 0.5s ease, background-color 0.5s ease;
        }

        /* 百分比文本 */
        .pipeline-progress-text {
            font-size: 12px;
            font-weight: 600;
            min-width: 38px;
            text-align: right;
            white-space: nowrap;
        }

        /* 三色样式类 */
        .progress-green  { background-color: #4caf50 !important; }
        .progress-orange { background-color: #ff9800 !important; }
        .progress-red    { background-color: #f44336 !important; }

        .progress-text-green  { color: #4caf50; }
        .progress-text-orange { color: #ff9800; }
        .progress-text-red    { color: #f44336; }

        /* ============================================================
        🔧 N-4：日志区分级过滤与清空
        ============================================================ */
        .pipeline-log-controls {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 4px 8px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            flex-shrink: 0;
        }
        .log-filter-btn {
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid rgba(255,255,255,0.1);
            background: transparent;
            color: var(--text-muted);
            transition: all 0.2s;
            font-family: 'SF Mono', monospace;
        }
        .log-filter-btn:hover {
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
        }
        .log-filter-btn.active {
            background: rgba(6,182,212,0.15);
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
        }
        .log-clear-btn {
            margin-left: auto;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 10px;
            cursor: pointer;
            border: 1px solid rgba(239,68,68,0.3);
            background: transparent;
            color: var(--accent-red);
            transition: all 0.2s;
        }
        .log-clear-btn:hover {
            background: rgba(239,68,68,0.15);
            border-color: var(--accent-red);
        }

        /* ============================================================
        🔧 N-5：刷新状态显示（最后更新时间 + 倒计时）
        ============================================================ */
        .pipeline-refresh-wrapper {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .pipeline-last-update {
            font-size: 10px;
            color: var(--text-muted);
            font-family: 'SF Mono', monospace;
            white-space: nowrap;
        }
        .pipeline-countdown {
            font-size: 10px;
            color: var(--accent-cyan);
            font-family: 'SF Mono', monospace;
            white-space: nowrap;
            min-width: 50px;
        }
        .pipeline-countdown-bar {
            width: 40px;
            height: 3px;
            background: rgba(255,255,255,0.08);
            border-radius: 2px;
            overflow: hidden;
        }
        .pipeline-countdown-fill {
            height: 100%;
            background: var(--accent-cyan);
            border-radius: 2px;
            transition: width 1s linear;
        }

        /* ============================================================
        🔧 N-6：抽屉内迷你趋势图（Canvas Sparkline）
        ============================================================ */
        .drawer-sparkline-section {
            padding: 12px 16px;
            border-top: 1px solid rgba(255,255,255,0.06);
        }
        .drawer-sparkline-title {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .drawer-sparkline-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 6px;
        }
        .drawer-sparkline-label {
            font-size: 11px;
            color: var(--text-secondary);
            min-width: 36px;
            font-weight: 600;
        }
        .drawer-sparkline-canvas-wrap {
            flex: 1;
            height: 28px;
            background: rgba(255,255,255,0.03);
            border-radius: 4px;
            overflow: hidden;
        }
        .drawer-sparkline-canvas-wrap canvas {
            width: 100%;
            height: 100%;
            display: block;
        }
        .drawer-sparkline-value {
            font-size: 11px;
            font-family: 'SF Mono', monospace;
            font-weight: 600;
            min-width: 42px;
            text-align: right;
        }
        .sparkline-cpu    { color: var(--accent-cyan, #06b6d4); }
        .sparkline-mem    { color: var(--accent-blue, #3b82f6); }
        .sparkline-net    { color: var(--accent-orange, #f97316); }

        /* ============================================================
        🔧 M-3:拓扑页面双视图切换(架构图 / 全链路拓扑)
        阶段 1:Tab 切换框架 + 全链路拓扑占位
        ============================================================ */

        /* ── 视图切换 Tab 容器 ── */
        .topo-view-switcher {
            display: flex;
            gap: 4px;
            margin-left: auto;
            margin-right: 16px;
            background: rgba(255,255,255,0.04);
            border-radius: 8px;
            padding: 3px;
        }

        .topo-view-tab {
            padding: 6px 14px;
            background: transparent;
            border: none;
            border-radius: 6px;
            color: var(--text-muted, #999);
            font-size: 12px;
            cursor: pointer;
            transition: all 0.25s;
            font-weight: 500;
            white-space: nowrap;
        }

        .topo-view-tab:hover {
            color: var(--accent-cyan, #06b6d4);
            background: rgba(6, 182, 212, 0.08);
        }

        .topo-view-tab.active {
            background: linear-gradient(135deg,
                rgba(6, 182, 212, 0.2),
                rgba(6, 182, 212, 0.1));
            color: var(--accent-cyan, #06b6d4);
            border: 1px solid rgba(6, 182, 212, 0.3);
            box-shadow: 0 0 12px rgba(6, 182, 212, 0.15);
        }

        /* ── 视图容器(双视图通过 display 控制切换) ── */
        .topo-canvas-wrapper {
            position: relative;
            flex: 1;
            width: 100%;
            min-height: 0;
            overflow: hidden;
        }

        .topo-view {
            width: 100%;
            height: 100%;
            position: relative;
        }

        .topo-view:not(.active) {
            display: none;
        }

        /* ── 全链路拓扑占位(阶段 1) ── */
        .full-link-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: var(--text-muted, #999);
            text-align: center;
            gap: 16px;
            padding: 40px;
        }

        .full-link-placeholder-icon {
            font-size: 64px;
            opacity: 0.6;
            animation: floatPlaceholder 3s ease-in-out infinite;
        }

        @keyframes floatPlaceholder {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(-8px); }
        }

        .full-link-placeholder-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--accent-cyan, #06b6d4);
            margin-bottom: 4px;
        }

        .full-link-placeholder-text {
            font-size: 13px;
            line-height: 1.7;
            max-width: 500px;
            color: var(--text-secondary, #aaa);
        }

        .full-link-placeholder-hint {
            font-size: 11px;
            color: var(--accent-cyan, #06b6d4);
            margin-top: 12px;
            padding: 8px 16px;
            background: rgba(6, 182, 212, 0.08);
            border: 1px dashed rgba(6, 182, 212, 0.3);
            border-radius: 6px;
        }

        /* ── 阶段标识徽章 ── */
        .full-link-roadmap {
            margin-top: 24px;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: center;
            max-width: 600px;
        }

        .roadmap-stage {
            padding: 4px 10px;
            font-size: 10px;
            border-radius: 4px;
            font-family: 'SF Mono', monospace;
        }

        .roadmap-stage.done {
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .roadmap-stage.pending {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text-muted, #999);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* ============================================================
        🔧 M-3 阶段 2:全链路拓扑节点卡片化渲染
        ============================================================ */

        /* ── 全链路拓扑画布容器(必须 position: relative,作为节点定位的参照) ── */
        .full-link-canvas {
            position: relative;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background:
                radial-gradient(circle at 20% 30%, rgba(6, 182, 212, 0.04) 0%, transparent 40%),
                radial-gradient(circle at 80% 70%, rgba(59, 130, 246, 0.04) 0%, transparent 40%);
        }

        /* ── AIOps 监控覆盖范围标识(右上角虚线徽章,呼应架构图风格) ── */
        .full-link-coverage-badge {
            position: absolute;
            top: 16px;
            right: 16px;
            padding: 6px 14px;
            border: 1px dashed rgba(6, 182, 212, 0.4);
            border-radius: 8px;
            background: rgba(6, 182, 212, 0.06);
            color: #06b6d4;
            font-size: 11px;
            font-family: 'SF Mono', monospace;
            z-index: 10;
            pointer-events: none;
            animation: coverageBadgeBreathe 3s infinite alternate ease-in-out;
        }

        @keyframes coverageBadgeBreathe {
            0%   { opacity: 0.6; box-shadow: 0 0 4px rgba(6, 182, 212, 0.2); }
            100% { opacity: 1.0; box-shadow: 0 0 12px rgba(6, 182, 212, 0.4); }
        }

        /* ── 5 层水平分层布局 ── */
        .full-link-tier {
            position: absolute;
            width: 100%;
            display: flex;
            justify-content: space-around;
            align-items: center;
            gap: 24px;
            padding: 0 60px;
            box-sizing: border-box;
        }

        .full-link-tier-1 { top: 4%;  height: 12%; }   /* 流量入口层 */
        .full-link-tier-2 { top: 22%; height: 12%; }   /* 负载均衡层 */
        .full-link-tier-3 { top: 40%; height: 14%; }   /* Web 应用层 */
        .full-link-tier-4 { top: 60%; height: 12%; }   /* 应用服务层 */
        .full-link-tier-5 { top: 78%; height: 14%; }   /* 数据层 */

        /* ── 主机节点卡片(基础样式) ── */
        .host-node {
            width: 180px;
            height: 100px;
            background: rgba(30, 41, 59, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            padding: 10px 12px;
            box-sizing: border-box;
            cursor: pointer;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            display: flex;
            flex-direction: column;
            gap: 4px;
            font-size: 11px;
            position: relative;
            overflow: hidden;
        }

        /* ── 6 种节点状态(数据属性选择器) ── */

        /* 状态 1:🌑 灰度待命(默认) */
        .host-node[data-state="idle"] {
            opacity: 0.35;
            filter: grayscale(70%) saturate(0.5);
        }

        /* 状态 2:🟢 数据通过(短暂闪烁) */
        .host-node[data-state="active"] {
            opacity: 1;
            border-color: rgba(6, 182, 212, 0.6);
            box-shadow: 0 0 16px rgba(6, 182, 212, 0.3);
            animation: nodePulseCyan 1.5s ease-out;
        }

        @keyframes nodePulseCyan {
            0%   { box-shadow: 0 0 4px rgba(6, 182, 212, 0.3); }
            50%  { box-shadow: 0 0 24px rgba(6, 182, 212, 0.6); }
            100% { box-shadow: 0 0 16px rgba(6, 182, 212, 0.3); }
        }

        /* 状态 3:🟡 持续活跃(正常) */
        .host-node[data-state="running"] {
            opacity: 1;
            border-color: rgba(6, 182, 212, 0.4);
            box-shadow: 0 0 8px rgba(6, 182, 212, 0.15);
        }

        /* 状态 4:🟠 警告(异常) */
        .host-node[data-state="warning"] {
            opacity: 1;
            border-color: rgba(249, 115, 22, 0.6);
            box-shadow: 0 0 14px rgba(249, 115, 22, 0.3);
            animation: nodeBreathOrange 2s infinite alternate ease-in-out;
        }

        @keyframes nodeBreathOrange {
            0%   { box-shadow: 0 0 6px rgba(249, 115, 22, 0.2); }
            100% { box-shadow: 0 0 18px rgba(249, 115, 22, 0.5); }
        }

        /* 状态 5:🔴 严重(根因) */
        .host-node[data-state="critical"] {
            opacity: 1;
            border-color: rgba(239, 68, 68, 0.8);
            box-shadow: 0 0 20px rgba(239, 68, 68, 0.5);
            transform: scale(1.05);
            animation: nodePulseRed 1.2s infinite alternate ease-in-out;
        }

        @keyframes nodePulseRed {
            0%   { box-shadow: 0 0 8px rgba(239, 68, 68, 0.3); transform: scale(1.03); }
            100% { box-shadow: 0 0 28px rgba(239, 68, 68, 0.7); transform: scale(1.07); }
        }

        /* 状态 6:🟤 症状(受根因影响) */
