    // ============================================================
    // 趋势图 Canvas
    // ============================================================
    function initTrendChart() {
        const canvas = document.getElementById('trendChart');
        if (!canvas) return;
        trendCtx = canvas.getContext('2d');
        resizeTrendChart();
        window.addEventListener('resize', resizeTrendChart);
    }

    function resizeTrendChart() {
        const canvas = document.getElementById('trendChart');
        if (!canvas || !canvas.parentElement) return;
        const rect = canvas.parentElement.getBoundingClientRect();
        canvas.width = rect.width * (window.devicePixelRatio || 1);
        canvas.height = rect.height * (window.devicePixelRatio || 1);
        canvas.style.width = rect.width + 'px';
        canvas.style.height = rect.height + 'px';
    }

    function updateTrendChart(history) {
        if (!trendCtx || !history) return;
        const canvas = trendCtx.canvas;
        const W = canvas.width;
        const H = canvas.height;
        const dpr = window.devicePixelRatio || 1;

        trendCtx.clearRect(0, 0, W, H);

        const cpuData = history.cpu || [];
        const memData = history.memory || [];
        const netData = history.net_in || [];
        const labels = history.timestamps || [];
        const len = cpuData.length;
        if (len < 2) return;

        const padL = 36 * dpr, padR = 8 * dpr, padT = 10 * dpr, padB = 22 * dpr;
        const chartW = W - padL - padR;
        const chartH = H - padT - padB;

        // 网格
        trendCtx.strokeStyle = 'rgba(255,255,255,0.04)';
        trendCtx.lineWidth = 1;
        for (let i = 0; i <= 4; i++) {
            const y = padT + chartH * i / 4;
            trendCtx.beginPath();
            trendCtx.moveTo(padL, y);
            trendCtx.lineTo(W - padR, y);
            trendCtx.stroke();
        }

        // Y 轴标签
        trendCtx.fillStyle = 'rgba(255,255,255,0.3)';
        trendCtx.font = (10 * dpr) + 'px sans-serif';
        trendCtx.textAlign = 'right';
        for (let i = 0; i <= 4; i++) {
            const y = padT + chartH * i / 4;
            trendCtx.fillText((100 - i * 25) + '%', padL - 4 * dpr, y + 3 * dpr);
        }

        // X 轴标签
        trendCtx.textAlign = 'center';
        const step = Math.max(1, Math.floor(len / 6));
        for (let i = 0; i < len; i += step) {
            const x = padL + (i / (len - 1)) * chartW;
            trendCtx.fillText(labels[i] || '', x, H - 4 * dpr);
        }

        // 画线函数
        function drawLine(data, color, maxVal) {
            if (!data.length) return;
            trendCtx.strokeStyle = color;
            trendCtx.lineWidth = 1.5 * dpr;
            trendCtx.beginPath();
            for (let i = 0; i < data.length; i++) {
                const x = padL + (i / (len - 1)) * chartW;
                const val = Math.min(data[i] || 0, maxVal);
                const y = padT + chartH * (1 - val / maxVal);
                if (i === 0) trendCtx.moveTo(x, y);
                else trendCtx.lineTo(x, y);
            }
            trendCtx.stroke();
            // 渐变填充
            const grad = trendCtx.createLinearGradient(0, padT, 0, padT + chartH);
            grad.addColorStop(0, color.replace(')', ',0.15)').replace('rgb', 'rgba'));
            grad.addColorStop(1, color.replace(')', ',0.0)').replace('rgb', 'rgba'));
            trendCtx.lineTo(padL + chartW, padT + chartH);
            trendCtx.lineTo(padL, padT + chartH);
            trendCtx.closePath();
            trendCtx.fillStyle = grad;
            trendCtx.fill();
        }

        drawLine(cpuData, 'rgb(6,182,212)', 100);
        drawLine(memData, 'rgb(139,92,246)', 100);

        // 网络单独缩放
        const netMax = Math.max(1, ...netData.map(v => v || 0)) * 1.2;
        drawLine(netData, 'rgb(16,185,129)', netMax);

        // 图例
        const legendY = padT + 4 * dpr;
        const legends = [
            { color: 'rgb(6,182,212)', label: 'CPU' },
            { color: 'rgb(139,92,246)', label: '内存' },
            { color: 'rgb(16,185,129)', label: '网络' },
        ];
        trendCtx.font = (9 * dpr) + 'px sans-serif';
        trendCtx.textAlign = 'left';
        let lx = padL + 4 * dpr;
        legends.forEach(leg => {
            trendCtx.fillStyle = leg.color;
            trendCtx.fillRect(lx, legendY, 12 * dpr, 3 * dpr);
            trendCtx.fillStyle = 'rgba(255,255,255,0.5)';
            trendCtx.fillText(leg.label, lx + 16 * dpr, legendY + 4 * dpr);
            lx += 56 * dpr;
        });
    }

