    function getNodeCenter(id) {
        const el = document.getElementById(id);
        const container = document.getElementById('topo-body');
        if (!el || !container) return { x: 0, y: 0 };
        const cr = container.getBoundingClientRect();
        const er = el.getBoundingClientRect();
        return {
            x: er.left - cr.left + er.width / 2,
            y: er.top - cr.top + er.height / 2
        };
    }

    // 核心路由计算函数（用于提取公共逻辑，保证连线和粒子轨迹一致）
    function calculateBezierControls(edge, from, to, containerHeight) {
        let dx = to.x - from.x;
        let dy = to.y - from.y;
        
        let cx1 = from.x + dx * 0.4;
        let cy1 = from.y;
        let cx2 = from.x + dx * 0.6;
        let cy2 = to.y;

        // 核心修复：解决 SVG 发光滤镜导致完美水平/垂直直线消失的 Bug
        // 给控制点增加极其微小的 2px 偏移，打破零面积包围盒，让虚线完美显现
        if (Math.abs(from.y - to.y) < 2) { cy1 += 2; cy2 -= 2; }
        if (Math.abs(from.x - to.x) < 2) { cx1 += 2; cx2 -= 2; }

        // 特殊路由 1：Agent Memory -> 态势感知 (从右向左大回流)
        if (edge.from === 'topo-node-memory' && edge.to === 'topo-node-awareness') {
            // 精确计算：将控制点设在 17% 高度，贝塞尔曲线的顶点会正好落在 22% 左右
            // 完美从"硬件问题(10%)"和"事件识别(34%)"之间的横向空隙中穿过
            const gapY = containerHeight * 0.17;
            cx1 = from.x;
            cy1 = gapY;
            cx2 = to.x;
            cy2 = gapY;
        }

        // 特殊路由 2：安全沙箱 -> 自动修复 (从右向左短回流)
        if (edge.from === 'topo-node-sandbox' && edge.to === 'topo-node-auto_fix') {
            // 向下绕出弧线，避开上方的水平去向连线
            cx1 = from.x;
            cy1 = from.y + containerHeight * 0.15;
            cx2 = to.x;
            cy2 = to.y + containerHeight * 0.15;
        }

        return { cx1, cy1, cx2, cy2 };
    }

    function drawTopoEdges() {
        const svg = document.getElementById('topo-svg');
        const container = document.getElementById('topo-body');
        if (!svg || !container) return;
        svg.querySelectorAll('.topo-edge').forEach(e => e.remove());
        
        const containerHeight = container.getBoundingClientRect().height;

        TOPO_EDGES.forEach(edge => {
            const from = getNodeCenter(edge.from);
            const to = getNodeCenter(edge.to);
            const { cx1, cy1, cx2, cy2 } = calculateBezierControls(edge, from, to, containerHeight);

            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.setAttribute('d', `M${from.x},${from.y} C${cx1},${cy1} ${cx2},${cy2} ${to.x},${to.y}`);
            path.setAttribute('class', 'topo-edge');
            path.setAttribute('stroke', 'rgba(6,182,212,0.8)');
            path.setAttribute('stroke-width', '2.5');
            path.setAttribute('stroke-dasharray', '8, 6');
            path.setAttribute('fill', 'none');
            path.setAttribute('filter', 'url(#glow)');
            svg.appendChild(path);
        });
    }

    function toggleTopoFlow() {
        if (topoFlowActive) {
            stopTopoFlow();
            return;
        }
        topoFlowActive = true;
        document.getElementById('topo-flow-btn').style.display = 'none';
        document.getElementById('topo-stop-btn').style.display = '';
        document.querySelectorAll('.topo-node').forEach(n => n.classList.add('active'));
        drawTopoEdges();
        animateTopoParticles();
    }

    function stopTopoFlow() {
        topoFlowActive = false;
        document.getElementById('topo-flow-btn').style.display = '';
        document.getElementById('topo-stop-btn').style.display = 'none';
        document.querySelectorAll('.topo-node').forEach(n => n.classList.remove('active'));
        if (topoAnimFrame) cancelAnimationFrame(topoAnimFrame);
        topoParticles = [];
        const svg = document.getElementById('topo-svg');
        if (svg) svg.querySelectorAll('.topo-particle').forEach(p => p.remove());
    }

    function animateTopoParticles() {
        if (!topoFlowActive) return;

        if (Math.random() < 0.6) {
            const edge = TOPO_EDGES[Math.floor(Math.random() * TOPO_EDGES.length)];
            topoParticles.push({
                from: edge.from,
                to: edge.to,
                progress: 0,
                speed: 0.006 + Math.random() * 0.008, // 稍微调慢粒子速度，视觉更舒适
                color: ['#06b6d4', '#3b82f6', '#8b5cf6', '#10b981', '#f59e0b'][Math.floor(Math.random() * 5)]
            });
        }

        const svg = document.getElementById('topo-svg');
        const container = document.getElementById('topo-body');
        if (!svg || !container) return;
        svg.querySelectorAll('.topo-particle').forEach(p => p.remove());
        
        const containerHeight = container.getBoundingClientRect().height;

        topoParticles = topoParticles.filter(p => {
            p.progress += p.speed;
            if (p.progress > 1) return false;

            const from = getNodeCenter(p.from);
            const to = getNodeCenter(p.to);
            // 复用同一套曲线路由算法
            const { cx1, cy1, cx2, cy2 } = calculateBezierControls(p, from, to, containerHeight);

            const t = p.progress;
            const mt = 1 - t;
            const x = mt*mt*mt*from.x + 3*mt*mt*t*cx1 + 3*mt*t*t*cx2 + t*t*t*to.x;
            const y = mt*mt*mt*from.y + 3*mt*mt*t*cy1 + 3*mt*t*t*cy2 + t*t*t*to.y;

            const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            circle.setAttribute('cx', x);
            circle.setAttribute('cy', y);
            circle.setAttribute('r', '3');
            circle.setAttribute('fill', p.color);
            circle.setAttribute('class', 'topo-particle');
            circle.setAttribute('filter', 'url(#glow)');
            svg.appendChild(circle);
            return true;
        });

        topoAnimFrame = requestAnimationFrame(animateTopoParticles);
    }
    
