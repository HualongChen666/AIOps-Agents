    async function runWorkflow() {
        if (isWorkflowRunning) return;
        isWorkflowRunning = true;
        const btn = document.getElementById('wf-run-btn');
        if (btn) { btn.textContent = '⏳ 运行中...'; btn.disabled = true; }
        setText('wf-status', '运行中');

        const logContent = document.getElementById('wf-log-content');

        function addWfLog(text, cls) {
            if (!logContent) return;
            const line = document.createElement('div');
            line.className = 'log-line';
            line.innerHTML = `<span class="log-time">${nowTimeStr()}</span> <span class="${cls || 'log-info'}">${escapeHTML(text)}</span>`;
            logContent.appendChild(line);
            logContent.scrollTop = logContent.scrollHeight;
        }

        try {
            const resp = await fetch(`/api/workflow/simulate/${currentWorkflow}`);
            const reader = resp.body.getReader();
            const decoder = new TextDecoder();
            let buffer = '';

            while (true) {
                const { done, value } = await reader.read();
                if (done) break;
                buffer += decoder.decode(value, { stream: true });

                const lines = buffer.split('\n');
                buffer = lines.pop() || '';

                for (const line of lines) {
                    if (!line.startsWith('data: ')) continue;
                    try {
                        const event = JSON.parse(line.substring(6));
                        handleWorkflowEvent(event, addWfLog);
                    } catch (e) { /* skip */ }
                }
            }
        } catch (e) {
            addWfLog('工作流执行失败: ' + e.message, 'log-error');
        }

        isWorkflowRunning = false;
        if (btn) { btn.textContent = '▶ 运行'; btn.disabled = false; }
    }

    function handleWorkflowEvent(event, addLog) {
        switch (event.type) {
            case 'workflow_start':
                addLog(event.log || '工作流开始', 'log-info');
                break;
            case 'step_start': {
                const node = document.getElementById('wf-node-' + event.node_key);
                if (node) { node.classList.add('running'); node.classList.remove('done', 'warn'); }
                addLog(event.log || `节点开始: ${event.node_title}`, 'log-info');
                break;
            }
            case 'step_warn': {
                const node = document.getElementById('wf-node-' + event.node_key);
                if (node) node.classList.add('warn');
                addLog(event.log || '节点警告', 'log-warn');
                break;
            }
            case 'step_complete': {
                const node = document.getElementById('wf-node-' + event.node_key);
                if (node) { node.classList.remove('running', 'warn'); node.classList.add('done'); }
                const durEl = document.getElementById('wf-dur-' + event.node_key);
                if (durEl) durEl.textContent = event.duration_ms + 'ms';
                addLog(event.log || `节点完成: ${event.node_title}`, 'log-success');
                break;
            }
            case 'workflow_done':
                setText('wf-status', `完成 ${event.total_ms}ms`);
                setText('wf-info-status', '已完成');
                addLog(event.log || '工作流完成', 'log-success');
                break;
            case 'error':
                addLog(event.msg || '工作流错误', 'log-error');
                break;
        }
    }

