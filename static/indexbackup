    // ============================================================
    // 🔧 M-2：提交 AI 分析反馈
    // ============================================================
    async function submitAIFeedback(feedbackId, feedbackType, btnEl) {
        const fbDiv = document.getElementById(feedbackId);
        if (!fbDiv) return;
        // 防止重复点击
        if (fbDiv.dataset.submitted === '1') {
            if (typeof addPipelineLog === 'function') {
                addPipelineLog('WARN', '该反馈已提交,无需重复操作');
            }
            return;
        }
        // 禁用所有按钮
        const allBtns = fbDiv.querySelectorAll('button');
        allBtns.forEach(b => {
            b.disabled = true;
            b.style.cursor = 'not-allowed';
            b.style.opacity = '0.5';
        });
        const resultSpan = document.getElementById(feedbackId + '-result');
        if (resultSpan) {
            resultSpan.textContent = '⏳ 提交中...';
            resultSpan.style.color = 'rgba(255,255,255,0.6)';
        }
        try {
            const resp = await fetch('/api/ai/feedback/submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    feedback_type: feedbackType,
                    analysis_text: fbDiv.dataset.analysisText || '',
                    query_text:    fbDiv.dataset.queryText    || '',
                    platform:      fbDiv.dataset.platform     || 'windows',
                    stage_name:    fbDiv.dataset.stageName    || '',
                    comment:       '',
                    rich_context:  fbDiv.dataset.richContext === '1',
                }),
            });
            if (!resp.ok) {
                const errText = await resp.text().catch(() => 'Unknown error');
                // 🔧 BUG-FIX-1:修复 throw new Error 缺少左括号的语法错误
                throw new Error(`HTTP ${resp.status}: ${errText.slice(0, 100)}`);
            }
            const data = await resp.json();
            // 🔧 BUG-FIX-9:成功后才标记 submitted,失败则保持可重试
            fbDiv.dataset.submitted = '1';
            // 视觉反馈:高亮被点击的按钮
            const emoji = feedbackType === 'positive' ? '👍' : '👎';
            const color = feedbackType === 'positive' ? '#00E676' : '#ef4444';
            btnEl.style.background = feedbackType === 'positive'
                ? 'rgba(0,230,118,0.4)'
                : 'rgba(239,68,68,0.4)';
            btnEl.style.opacity = '1';
            const stats = data.stats || {};
            if (resultSpan) {
                // 🔧 BUG-FIX-2:在 </span> 后加空格,防止文字粘连
                resultSpan.innerHTML =
                    `<span style="color:${color};">${emoji} 已记录</span> ` +
                    `<span style="color:rgba(255,255,255,0.4);">` +
                    `(累计 ${stats.total || 0} 评价 / 准确率 ${stats.accuracy || 0}%)</span>`;
            }
            if (typeof addPipelineLog === 'function') {
                // 🔧 BUG-FIX-3:在 | 后加空格,防止日志文字粘连
                addPipelineLog('INFO',
                    `AI 反馈已提交 | ${emoji} ${feedbackType} | ` +
                    `累计反馈=${stats.total || 0} 准确率=${stats.accuracy || 0}%`
                );
            }
            // 🔧 BUG-FIX-7:仅在函数存在时调用,避免静默失败
            if (typeof refreshPipelineData === 'function') {
                setTimeout(() => {
                    try {
                        refreshPipelineData();
                    } catch (refreshErr) {
                        console.warn('[M-2] 刷新流水线数据失败:', refreshErr);
                    }
                }, 500);
            }
        } catch (err) {
            console.error('[M-2] 反馈提交失败:', err);
            if (typeof addPipelineLog === 'function') {
                addPipelineLog('ERROR', '反馈提交失败: ' + err.message);
            }
            if (resultSpan) {
                resultSpan.textContent = '❌ 提交失败,请重试';
                resultSpan.style.color = '#ef4444';
            }
            // 🔧 BUG-FIX-9:失败时恢复按钮可点击,允许用户重试
            allBtns.forEach(b => {
                b.disabled = false;
                b.style.cursor = 'pointer';
                b.style.opacity = '1';
            });
        }
    }

