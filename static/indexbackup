        /* 🔧 M-3 阶段3:SVG 依赖边流动动画 */
        @keyframes dashFlow {
            to { stroke-dashoffset: -20; }
        }
        .full-link-edges path {
            transition: stroke 0.3s ease, opacity 0.3s ease;
        }

        
        /* 🔧 M-3 阶段4:粒子流动画(4 种因果状态) */

        /* 粒子沿路径流动(CSS Motion Path:Chrome ≥79 / Edge ≥79 / Firefox ≥72 / Safari ≥16) */
        @keyframes particleFlow {
            from { offset-distance: 0%;   opacity: 0; }
            10%  { opacity: 1; }
            90%  { opacity: 1; }
            to   { offset-distance: 100%; opacity: 0; }
        }

        /* 4 种边的颜色与发光效果(用 data-edge-state 避免与节点 data-state 冲突) */
        .full-link-edges path[data-edge-state="normal"] {
            stroke: #00d2d3;
            stroke-width: 2;
            opacity: 0.4;
            filter: drop-shadow(0 0 2px rgba(0, 210, 211, 0.4));
        }
        .full-link-edges path[data-edge-state="root_cause"] {
            stroke: #ff4757;
            stroke-width: 3;
            opacity: 0.85;
            filter: drop-shadow(0 0 8px rgba(255, 71, 87, 0.7));
        }
        .full-link-edges path[data-edge-state="symptom"] {
            stroke: #ffa502;
            stroke-width: 2.5;
            opacity: 0.75;
            filter: drop-shadow(0 0 6px rgba(255, 165, 2, 0.6));
        }
        .full-link-edges path[data-edge-state="healing"] {
            stroke: #2ed573;
            stroke-width: 2.5;
            opacity: 0.75;
            filter: drop-shadow(0 0 6px rgba(46, 213, 115, 0.6));
        }

        /* 4 种粒子的颜色与大小 */
        .full-link-particles circle {
            pointer-events: none;
        }
        .full-link-particles circle[data-edge-state="normal"] {
            fill: #00d2d3;
            filter: drop-shadow(0 0 4px rgba(0, 210, 211, 0.8));
        }
        .full-link-particles circle[data-edge-state="root_cause"] {
            fill: #ff4757;
            filter: drop-shadow(0 0 6px rgba(255, 71, 87, 1));
        }
        .full-link-particles circle[data-edge-state="symptom"] {
            fill: #ffa502;
            filter: drop-shadow(0 0 5px rgba(255, 165, 2, 0.9));
        }
        .full-link-particles circle[data-edge-state="healing"] {
            fill: #2ed573;
            filter: drop-shadow(0 0 5px rgba(46, 213, 115, 0.9));
        }

        /* 🔧 M-3 阶段4:症状节点徽章(根因徽章已由 renderHostNode 内置,不重复加) */
        .symptom-badge-overlay {
            position: absolute;
            top: -8px;
