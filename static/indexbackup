            if (!resp.ok) return;
            const history = await resp.json();

            // 浮窗可能已被关闭,二次确认
            if (window._m3p5.sparklinePopup !== popup) return;

            if (typeof drawSparkline === 'function') {
                drawSparkline(cpuCanvas, history.cpu || [], '#00d2d3');
                drawSparkline(memCanvas, history.memory || [], '#ffa502');
            } else {
                console.debug('[M-3 阶段5] drawSparkline 函数不存在,跳过 Sparkline 绘制');
            }
        } catch (e) {
            console.warn('[M-3 阶段5] Sparkline 数据加载失败:', e);
        }
    }

