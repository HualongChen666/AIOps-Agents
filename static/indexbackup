    <script>

    // ============================================================
    // 🌐 I18N — 前端轻量国际化引擎
    // ============================================================
    const I18N = {
        _locale: (() => {
            const saved = localStorage.getItem('aiops_lang');
            if (saved === 'zh' || saved === 'en') return saved;
            return navigator.language.startsWith('en') ? 'en' : 'zh';
        })(),
        _messages: { zh: {}, en: {} },

        t(key, params = {}) {
            let text = this._messages[this._locale]?.[key]
                    || this._messages['zh']?.[key]
                    || key;
            for (const [k, v] of Object.entries(params)) {
                text = text.replaceAll(`{${k}}`, v);
            }
            return text;
        },

        setLocale(lang) {
            if (lang !== 'zh' && lang !== 'en') lang = 'zh';
            this._locale = lang;
            localStorage.setItem('aiops_lang', lang);
            this._refreshUI();
            window.dispatchEvent(new CustomEvent('locale-changed', {
                detail: { locale: lang }
            }));
            console.log(`[I18N] Language switched to: ${lang}`);
        },

        getLocale() { return this._locale; },

        _refreshUI() {
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (key) el.textContent = this.t(key);
            });
            document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
                const key = el.getAttribute('data-i18n-placeholder');
                if (key) el.placeholder = this.t(key);
            });
            document.querySelectorAll('[data-i18n-title]').forEach(el => {
                const key = el.getAttribute('data-i18n-title');
                if (key) el.title = this.t(key);
                });
        },

        async loadFromServer() {
            try {
                const [zhRes, enRes] = await Promise.all([
                    fetch('/static/messages/zh.json').then(r => r.ok ? r.json() : {}),
                    fetch('/static/messages/en.json').then(r => r.ok ? r.json() : {}),
                ]);
                // 过滤 _meta 等元数据键
                const filterMeta = (obj) => {
                    const result = {};
                    for (const [k, v] of Object.entries(obj)) {
                        if (!k.startsWith('_')) result[k] = v;
                    }
                    return result;
                };
                    Object.assign(this._messages.zh, filterMeta(zhRes));
                    Object.assign(this._messages.en, filterMeta(enRes));
                    this._refreshUI();
                    console.log('[I18N] Language packs loaded from server');
                } catch (e) {
                    console.warn('[I18N] Failed to load language packs, using inline fallback:', e);
                }
            }
        };

    // ── 内联语言包(首屏关键文本,防闪烁) ──
