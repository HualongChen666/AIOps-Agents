            z-index: 10;
            animation: badgePulse 1.5s ease-in-out infinite;
            pointer-events: none;
        }
        @keyframes badgePulse {
            0%, 100% { transform: scale(1);   opacity: 1; }
            50%      { transform: scale(1.1); opacity: 0.85; }
        }

        /* 🔧 M-3 阶段4:因果摘要状态栏徽章 */
        .causal-summary-item {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 10px;
            margin-left: 8px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: bold;
        }
        .causal-summary-item.root {
            background: rgba(255, 71, 87, 0.15);
            color: #ff4757;
            border: 1px solid rgba(255, 71, 87, 0.4);
        }
        .causal-summary-item.symptom {
            background: rgba(255, 165, 2, 0.15);
            color: #ffa502;
            border: 1px solid rgba(255, 165, 2, 0.4);
        }
        .causal-summary-item.healing {
            background: rgba(46, 213, 115, 0.15);
            color: #2ed573;
