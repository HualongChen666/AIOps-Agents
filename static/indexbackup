        entry.innerHTML =
            `<span style="color:var(--text-muted,#666);min-width:60px;">${now}</span>` +
            `<span style="color:${levelColor};min-width:40px;font-weight:600;">${normalizedLevel}</span>` +
            `<span style="color:var(--text-secondary,#aaa);flex:1;">${msg}</span>`;
        // 🔧 N-4：如果当前过滤级别不匹配，新追加的日志默认隐藏
        if (_currentLogFilter !== 'ALL' && _currentLogFilter !== normalizedLevel) {
            entry.style.display = 'none';
