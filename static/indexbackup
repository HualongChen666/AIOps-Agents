    <!-- ════════════════════════════════════════════════════════
        🆕 N+4 任务:i18n 初始化 + 语言切换 + N+2 验证 UI 集成
        ─────────────────────────────────────────────────────────
        必须放在所有业务 JS 之后,确保:
        1. window.I18N / window.VerifyUI 已通过 <head> 中的 JS 加载
        2. switchPage / fetch 等业务函数已定义
        3. data-i18n DOM 节点已渲染完成(MutationObserver 兜底)
        ════════════════════════════════════════════════════════ -->
    <script>
    (async function () {
        'use strict';

        // ============================================================
        // [N4-1] 初始化 i18n 引擎(必须最先执行)
        // ============================================================
        try {
            if (!window.I18N) {
                console.error('[N+4] ❌ window.I18N 未定义,请检查 static/js/i18n.js 是否正确加载');
                return;
            }
            const locale = await window.I18N.ready();
            console.info(`[N+4] ✅ i18n 引擎就绪 | 当前语言: ${locale}`);
            document.documentElement.setAttribute('lang', locale === 'en' ? 'en' : 'zh-CN');
        } catch (err) {
            console.error('[N+4] ❌ i18n 引擎初始化失败:', err);
            return;
        }

        // ============================================================
        // [N4-2] 绑定顶部"🌐 中/En"语言切换按钮
        // ─────────────────────────────────────────────────────────
        // 真实代码中按钮文本为 "🌐 中/En"
        // 由于无法确定 class 名,采用"多策略选择器 + 文本匹配"兜底
        // ============================================================
        let langSwitcher = null;

        // 策略 1:class / id / data-* 选择器
        const selectors = [
            '.lang-switcher',
            '#lang-switcher',
            '[data-action="switch-lang"]',
            '[onclick*="switchLang"]',
            '[onclick*="setLocale"]',
            '[onclick*="changeLang"]',
        ];
        for (const sel of selectors) {
            langSwitcher = document.querySelector(sel);
            if (langSwitcher) {
                console.info(`[N+4] 通过选择器找到语言切换按钮: ${sel}`);
                break;
            }
        }

        // 策略 2:通过文本内容匹配兜底
        if (!langSwitcher) {
            const candidates = document.querySelectorAll('span, button, a, div');
            for (const el of candidates) {
                const text = (el.textContent || '').trim();
                // 严格精确匹配,避免误命中
                if (text === '🌐 中/En' || text === '🌐 Zh/En' ||
                    text === '中/En' || text === 'Zh/En') {
                    // 排除子节点过多的容器
                    if (el.children.length <= 1) {
                        langSwitcher = el;
                        console.info('[N+4] 通过文本匹配找到语言切换按钮');
                        break;
                    }
                }
            }
        }

        if (langSwitcher) {
            langSwitcher.style.cursor = 'pointer';
            langSwitcher.style.userSelect = 'none';
            // 移除可能存在的 onclick(避免冲突)
            const oldOnclick = langSwitcher.getAttribute('onclick');
            if (oldOnclick) {
                console.info(`[N+4] 已移除原 onclick: ${oldOnclick}`);
                langSwitcher.removeAttribute('onclick');
            }

            // 绑定切换事件
            langSwitcher.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                const current = window.I18N.getLocale();
                const next = current === 'zh' ? 'en' : 'zh';
                window.I18N.setLocale(next);
                // 更新按钮文本
                langSwitcher.textContent = next === 'zh' ? '🌐 中/En' : '🌐 Zh/En';
                console.info(`[N+4] 🌐 语言已切换: ${current} → ${next}`);
            });

            // 初始化按钮文本
            const initLocale = window.I18N.getLocale();
            langSwitcher.textContent = initLocale === 'zh' ? '🌐 中/En' : '🌐 Zh/En';
        } else {
            console.warn('[N+4] ⚠️ 未找到语言切换按钮,中英切换功能不可用');
            console.warn('[N+4]    请在 HTML 中给"🌐 中/En"按钮添加 class="lang-switcher"');
        }

        // ============================================================
        // [N4-3] N+2 验证 UI:双指标对比卡片
        // ─────────────────────────────────────────────────────────
        // 数据源:GET /api/stats/summary
        //   后端字段(已确认存在,详见 core/stats_engine.py):
        //     - heal_rate          : 命令退出码成功率(可能虚高)
        //     - verified_heal_rate : verifier 真实验证成功率(N+2)
        //     - verify_coverage    : 验证覆盖率(N+2)
        // ============================================================
        async function refreshVerifyComparison() {
            const container = document.getElementById('verify-comparison-container');
            if (!container) {
                console.debug('[N+4] verify-comparison-container 不存在,跳过双指标卡片');
                return;
            }

            if (!window.VerifyUI || typeof window.VerifyUI.renderComparison !== 'function') {
                console.warn('[N+4] window.VerifyUI 未定义,请检查 verify-ui.js');
                return;
            }

            try {
                // 使用 I18N.fetch 自动带 Accept-Language 头
                const resp = await window.I18N.fetch('/api/stats/summary');
                if (!resp.ok) {
                    console.warn(`[N+4] /api/stats/summary 返回 HTTP ${resp.status}`);
                    return;
                }
                const data = await resp.json();

                // 防御性默认值(参考 core/stats_engine.py 三层降级原则)
                const healRate = typeof data.heal_rate === 'number' ? data.heal_rate : 0;
                const verifiedRate = typeof data.verified_heal_rate === 'number'
                    ? data.verified_heal_rate
                    : healRate;  // 降级为 heal_rate
                const coverage = typeof data.verify_coverage === 'number'
                    ? data.verify_coverage
                    : 0;

                container.innerHTML = window.VerifyUI.renderComparison(
                    healRate, verifiedRate, coverage
                );
                console.debug(
                    `[N+4] 双指标卡片刷新 | heal=${healRate}% verified=${verifiedRate}% coverage=${coverage}%`
                );
            } catch (err) {
                console.warn('[N+4] 双指标对比卡片刷新失败:', err);
            }
        }

        // 等待 300ms 让其他业务 JS 完成初始化
        setTimeout(refreshVerifyComparison, 300);

        // 每 30 秒刷新一次(与后端 stats_engine 5 秒 TTL 缓存配合)
        setInterval(refreshVerifyComparison, 30000);

        // 语言切换时立即刷新(让卡片标题跟随语言)
        window.addEventListener('i18n:changed', refreshVerifyComparison);

        // ============================================================
        // [N4-4] 修复历史列表自动注入验证徽章
        // ─────────────────────────────────────────────────────────
        // 监听新增的含 data-verify-result 属性的元素,自动渲染徽章
        // 业务 JS 需要在渲染修复历史时:
        //   <div data-verify-result='${JSON.stringify(verify)}'>...</div>
        // ============================================================
        function injectVerifyBadgesToList() {
            if (!window.VerifyUI || typeof window.VerifyUI.renderBadge !== 'function') {
                return;
            }
            const targets = document.querySelectorAll(
                '[data-verify-result]:not([data-verify-rendered])'
            );
            let injected = 0;
            targets.forEach(el => {
                try {
                    const raw = el.getAttribute('data-verify-result');
                    if (!raw) return;
                    const verify = JSON.parse(raw);
                    const badgeHtml = window.VerifyUI.renderBadge(verify);
                    el.insertAdjacentHTML('beforeend', badgeHtml);
                    el.setAttribute('data-verify-rendered', '1');
                    injected++;
                } catch (e) {
                    console.debug('[N+4] verify 数据解析失败,跳过:', e);
                }
            });
            if (injected > 0) {
                console.debug(`[N+4] 已注入 ${injected} 个验证徽章`);
            }
        }

        // 防抖执行(避免高频 DOM 更新)
        let injectTimer = null;
        const observer = new MutationObserver(() => {
            if (injectTimer) clearTimeout(injectTimer);
            injectTimer = setTimeout(injectVerifyBadgesToList, 100);
        });
        observer.observe(document.body, {
            childList: true,
            subtree: true,
            attributes: false,
        });

        // 首次执行
        injectVerifyBadgesToList();

        console.info('[N+4] ✅ N+4 任务全部初始化完成');
    })();
    </script>

