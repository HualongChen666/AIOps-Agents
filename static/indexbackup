    /**
    * 🔧 N-6：在 Canvas 上绘制 Sparkline 迷你趋势线
    * @param {string} canvasId - Canvas 元素的 id
    * @param {number[]} data   - 数值数组
    * @param {string} color    - 线条颜色（CSS 颜色值）
    */
    function drawSparkline(canvasOrId, data, color) {
    const canvas = (typeof canvasOrId === 'string')
        ? document.getElementById(canvasOrId)
        : canvasOrId;
        if (!canvas || !data || data.length < 2) return;

        const ctx = canvas.getContext('2d');
        const width = canvas.width;
        const height = canvas.height;

        // 清空画布
        ctx.clearRect(0, 0, width, height);

        // 计算数据范围
        const max = Math.max(...data);
        const min = Math.min(...data);
        const range = max - min || 1; // 防止除以 0

        // 留出上下 padding，防止线条被边缘裁剪
        const padding = 4;
        const drawHeight = height - padding * 2;

        // 绘制线条
        ctx.strokeStyle = color;
        ctx.lineWidth = 2;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.beginPath();

        data.forEach(function(val, index) {
            var x = (index / (data.length - 1)) * width;
            var y = height - padding - ((val - min) / range) * drawHeight;

            if (index === 0) {
                ctx.moveTo(x, y);
            } else {
                ctx.lineTo(x, y);
            }
        });

        ctx.stroke();

        // 绘制渐变填充
        ctx.lineTo(width, height);
        ctx.lineTo(0, height);
        ctx.closePath();

        var gradient = ctx.createLinearGradient(0, 0, 0, height);
        // 从颜色字符串提取 RGB 用于半透明填充
        gradient.addColorStop(0, color.replace(')', ', 0.2)').replace('rgb', 'rgba'));
        gradient.addColorStop(1, color.replace(')', ', 0)').replace('rgb', 'rgba'));

        // 降级处理：如果颜色不是 rgb 格式，使用固定半透明色
        if (color.startsWith('#') || color.startsWith('var')) {
            gradient = ctx.createLinearGradient(0, 0, 0, height);
            gradient.addColorStop(0, 'rgba(255,255,255,0.08)');
            gradient.addColorStop(1, 'rgba(255,255,255,0)');
        }

        ctx.fillStyle = gradient;
        ctx.fill();
    }

    /**
    * 🔧 N-6：从 API 获取历史数据并绘制三条 Sparkline
    */
    async function loadDrawerSparklines() {
        var section = document.getElementById('drawer-sparkline-section');
        if (!section) return;

        try {
            var resp = await fetch('/api/metrics/history');
            if (!resp.ok) {
                console.warn('[N-6] /api/metrics/history 请求失败:', resp.status);
                return;
            }
            var data = await resp.json();

            var cpuData = data.cpu || [];
            var memData = data.memory || [];
            var netData = data.net_in || [];

            // 绘制三条 Sparkline
            drawSparkline('drawer-spark-cpu', cpuData, '#06b6d4');
            drawSparkline('drawer-spark-mem', memData, '#3b82f6');
            drawSparkline('drawer-spark-net', netData, '#f97316');

            // 更新最新值文字
            var cpuVal = document.getElementById('drawer-spark-cpu-val');
            var memVal = document.getElementById('drawer-spark-mem-val');
            var netVal = document.getElementById('drawer-spark-net-val');

            if (cpuVal && cpuData.length > 0) {
                cpuVal.textContent = cpuData[cpuData.length - 1].toFixed(1) + '%';
            }
            if (memVal && memData.length > 0) {
                memVal.textContent = memData[memData.length - 1].toFixed(1) + '%';
            }
            if (netVal && netData.length > 0) {
                var lastNet = netData[netData.length - 1];
                netVal.textContent = lastNet >= 1 ? lastNet.toFixed(1) + ' MB/s' : (lastNet * 1024).toFixed(0) + ' KB/s';
            }

            if (typeof addPipelineLog === 'function') {
                addPipelineLog('INFO', '抽屉趋势图数据已加载（' + cpuData.length + ' 个数据点）');
            }

        } catch (err) {
            console.error('[N-6] 加载趋势图数据异常:', err);
            if (typeof addPipelineLog === 'function') {
                addPipelineLog('WARN', '趋势图数据加载失败: ' + err.message);
            }
        }
    }
