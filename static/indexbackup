    // ============================================================
    // WebSocket 实时数据
    // ============================================================
    function connectWebSocket() {
        if (ws && ws.readyState === WebSocket.OPEN) return;
        const protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
        ws = new WebSocket(`${protocol}//${location.host}/ws/realtime`);

        ws.onopen = () => {
            console.log('[WS] 已连接');
            if (wsReconnectTimer) { clearTimeout(wsReconnectTimer); wsReconnectTimer = null; }
            // 心跳
            if (wsHeartbeatTimer) clearInterval(wsHeartbeatTimer);
            wsHeartbeatTimer = setInterval(() => {
                if (ws && ws.readyState === WebSocket.OPEN) ws.send('ping');
            }, 25000);
        };

        ws.onmessage = (event) => {
            if (event.data === 'pong') return;
            try {
                const data = JSON.parse(event.data);
                if (data.type === 'realtime') {
                    const m = data.metrics || {};

                    // 资源 TOP
                    setText('res-top-cpu', m.cpu !== undefined ? m.cpu + '%' : '--%');
                    setText('res-top-mem', m.memory !== undefined ? m.memory + '%' : '--%');
                    setText('res-top-disk', m.disk !== undefined ? m.disk + '%' : '--%');

                    // Windows 微缩
                    setText('mini-win-cpu', `CPU ${m.cpu != null ? m.cpu : '--'}%`);
                    setText('mini-win-mem', `内存 ${m.memory != null ? m.memory : '--'}%`);

                    // 基础设施页 Windows 指标
                    setText('infra-win-cpu', m.cpu != null ? m.cpu + '%' : '--%');
                    setText('infra-win-mem', m.memory != null ? m.memory + '%' : '--%');
                    setText('infra-win-disk', m.disk != null ? m.disk + '%' : '--%');
                    setText('infra-win-net', m.net_in != null ? m.net_in.toFixed(2) + ' MB/s' : '-- MB/s');

                    // 趋势图
                    if (data.history) updateTrendChart(data.history);

                    // 实时统计摘要
                    if (data.summary) {
                        const s = data.summary;
                        setText('kpi-total-alerts', s.total_alerts, '0');
                        setText('kpi-resolved', s.resolved, '0');
                        setText('kpi-mttd', s.mttd_min + 'min', '--');
                        setText('kpi-rca-accuracy', s.rca_accuracy + '%', '--');
                        setText('gauge-noise', s.noise_reduction + '%', '--');
                        setText('gauge-heal', s.heal_rate + '%', '--');
                        setText('gauge-health', s.agent_health + '%', '--');
                        updateGaugeArc('gauge-noise-arc', s.noise_reduction, 'var(--accent-cyan)');
                        updateGaugeArc('gauge-heal-arc', s.heal_rate, 'var(--accent-green)');
                        updateGaugeArc('gauge-health-arc', s.agent_health, 'var(--accent-blue)');
                    }

                    // 实时告警
                    if (data.alerts && data.alerts.length > 0) {
                        renderDashboardAlerts(data.alerts);
                    }
                }
            } catch (e) {
                console.warn('[WS] 消息解析失败:', e);
            }
        };

        ws.onclose = () => {
            console.warn('[WS] 断开，5秒后重连...');
            if (wsHeartbeatTimer) { clearInterval(wsHeartbeatTimer); wsHeartbeatTimer = null; }
            wsReconnectTimer = setTimeout(connectWebSocket, 5000);
        };

        ws.onerror = (err) => {
            console.error('[WS] 连接错误:', err);
            showToast({type:'error', message:'WebSocket 连接错误，请检查网络或后端状态', duration:5000});
            try { ws.close(); } catch(e) {}
        };
    }

