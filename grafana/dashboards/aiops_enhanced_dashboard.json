{
  "dashboard": {
    "title": "AIOps Agent Enhanced Monitoring Dashboard",
    "uid": "aiops-enhanced-dashboard",
    "tags": ["aiops", "monitoring", "enhanced"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "System Overview",
        "type": "stat",
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "up{job='aiops-agent'}",
            "legendFormat": "Instance {{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "CPU Usage"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Memory Usage"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "Disk Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "(1 - (node_filesystem_avail_bytes{fstype!~\"ext[234]|xfs\"} / node_filesystem_size_bytes{fstype!~\"ext[234]|xfs\"})) * 100",
            "legendFormat": "{{instance}}: {{mountpoint}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Disk Usage"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Network I/O",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "rate(node_network_receive_bytes_total[5m])",
            "legendFormat": "{{instance}} RX",
            "refId": "A"
          },
          {
            "expr": "rate(node_network_transmit_bytes_total[5m])",
            "legendFormat": "{{instance}} TX",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "Bps", "label": "Network I/O"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "API Request Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{method}} {{endpoint}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/s"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "API Error Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "rate(http_requests_total{status=~\"5..\"}[5m]) / rate(http_requests_total[5m])",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Error Rate"},
          {"format": "short"}
        ]
      },
      {
        "id": 8,
        "title": "API Latency (95th percentile)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latency"},
          {"format": "short"}
        ]
      },
      {
        "id": 9,
        "title": "Database Connection Pool",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [
          {
            "expr": "pg_stat_activity_count / pg_settings_max_connections",
            "legendFormat": "Connection Pool Usage",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Pool Usage"},
          {"format": "short"}
        ]
      },
      {
        "id": 10,
        "title": "Alert Statistics",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 0, "y": 36},
        "targets": [
          {
            "expr": "aiops_alerts_pending",
            "legendFormat": "Pending Alerts",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 100},
                {"color": "red", "value": 500}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Repair Success Rate",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 8, "y": 36},
        "targets": [
          {
            "expr": "rate(aiops_repairs_successful_total[5m]) / rate(aiops_repairs_total[5m])",
            "legendFormat": "Success Rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 0.8},
                {"color": "green", "value": 0.9}
              ]
            }
          }
        }
      },
      {
        "id": 12,
        "title": "AI Analysis Latency",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 16, "y": 36},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(aiops_ai_analysis_duration_seconds_bucket[5m]))",
            "legendFormat": "95th Percentile",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 30}
              ]
            }
          }
        }
      },
      {
        "id": 13,
        "title": "🔧 P0 Enhancement: Backup Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 12, "x": 0, "y": 40},
        "targets": [
          {
            "expr": "aiops_backup_last_status",
            "legendFormat": "Last Backup Status",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": {"text": "Failed", "color": "red"},
                  "1": {"text": "Success", "color": "green"}
                },
                "type": "value"
              }
            ]
          }
        }
      },
      {
        "id": 14,
        "title": "🔧 P0 Enhancement: Backup Storage",
        "type": "stat",
        "gridPos": {"h": 4, "w": 12, "x": 12, "y": 40},
        "targets": [
          {
            "expr": "aiops_backup_storage_available / aiops_backup_storage_total",
            "legendFormat": "Storage Available",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 0.2},
                {"color": "green", "value": 0.5}
              ]
            }
          }
        }
      },
      {
        "id": 15,
        "title": "🔧 P1 Enhancement: APM Error Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 44},
        "targets": [
          {
            "expr": "aiops_apm_error_rate",
            "legendFormat": "Error Rate",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Error Rate"},
          {"format": "short"}
        ]
      },
      {
        "id": 16,
        "title": "🔧 P1 Enhancement: Slow Request Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 44},
        "targets": [
          {
            "expr": "aiops_apm_slow_request_rate",
            "legendFormat": "Slow Request Rate",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Slow Request Rate"},
          {"format": "short"}
        ]
      },
      {
        "id": 17,
        "title": "🔧 P0 Enhancement: Health Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 12, "x": 0, "y": 52},
        "targets": [
          {
            "expr": "aiops_health_status",
            "legendFormat": "Health Status",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": {"text": "Unhealthy", "color": "red"},
                  "1": {"text": "Healthy", "color": "green"}
                },
                "type": "value"
              }
            ]
          }
        }
      },
      {
        "id": 18,
        "title": "🔧 P0 Enhancement: System Resource Usage",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 12, "x": 12, "y": 52},
        "targets": [
          {
            "expr": "aiops_system_resource_usage",
            "legendFormat": "Resource Usage",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 0.7},
                {"color": "red", "value": 0.9}
              ]
            }
          }
        }
      },
      {
        "id": 19,
        "title": "Authentication Failures",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56},
        "targets": [
          {
            "expr": "rate(aiops_auth_failures_total[5m])",
            "legendFormat": "Auth Failures",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Failures/s"},
          {"format": "short"}
        ]
      },
      {
        "id": 20,
        "title": "Rate Limit Exceeded",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56},
        "targets": [
          {
            "expr": "rate(aiops_rate_limit_exceeded_total[5m])",
            "legendFormat": "Rate Limit Exceeded",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Exceeds/s"},
          {"format": "short"}
        ]
      }
    ]
  }
}