{
  "title": "AIOps Agent 错误日志分析",
  "uid": "aiops-error-logging",
  "tags": [
    "aiops",
    "error",
    "logging"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "错误总数趋势",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(aiops_api_errors_total[5m])) by (error_type)",
          "legendFormat": "{{error_code}}"
        }
      ],
      "yaxes": [
        {
          "format": "short"
        }
      ]
    },
    {
      "id": 2,
      "title": "错误分类统计（按端点）",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum(aiops_api_errors_total) by (endpoint)",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "错误分类统计（按方法）",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(aiops_api_errors_total) by (method)",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "最频繁的错误码",
      "type": "table",
      "targets": [
        {
          "expr": "topk(10, sum(aiops_api_errors_total) by (error_type))",
          "legendFormat": "{{error_code}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "错误率（错误/分钟）",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(aiops_api_errors_total[1m])",
          "legendFormat": "错误率"
        }
      ]
    },
    {
      "id": 6,
      "title": "API 响应时间分布（直方图）",
      "type": "heatmap",
      "targets": [
        {
          "expr": "sum(rate(aiops_api_response_time_seconds_bucket[5m])) by (le)",
          "legendFormat": "P95"
        }
      ]
    }
  ]
}
