[flake8]
max-line-length = 120
extend-ignore = E203, W503, E402
exclude = .git, __pycache__, .venv, venv, build, dist, .eggs, *.egg-info, .pytest_cache, .mypy_cache, .tox, .hg, temp, temp_*.py, verify_logs
per-file-ignores =
    main.py: F401, F811, F841
    scripts/*: E501
    extensions/addons/ai-plus/rag_service/main.py: F401, E231
    extensions/addons/security/security_scanning_service/main.py: F401, E501
    extensions/hardware_remediation/raid_storcli.py: E501
    api/autoheal_router.py: F401
    apply_mypy_ignores.py: E741
    core/heal_graph.py: F401
    core/resilience.py: F401
    gen_badge.py: E501
