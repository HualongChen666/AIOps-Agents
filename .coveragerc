branch = True
parallel = True
data_file = .coverage

[report]
precision = 2
show_missing = True
skip_empty = True
sort = Cover
exclude_lines = 
	pragma: no cover
	
	def __repr__
	def __str__
	raise AssertionError
	raise NotImplementedError
	if __name__ == .__main__.:
	if TYPE_CHECKING:
	if MYPY:
	
	@abstractmethod
	@abc.abstractmethod
	
	: typing.
	from typing import
	
	assert False
	assert debug
	
	except ImportError:
	except Exception:
	
	class Test
	def test_

[html]
directory = htmlcov
title = AIOps Agent Coverage Report

[xml]
output = coverage.xml

[json]
output = coverage.json

[paths]
source = 
	core/
	*/core/
