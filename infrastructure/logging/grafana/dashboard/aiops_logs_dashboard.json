{
  "dashboard": {
    "title": "AIOps Logs Dashboard",
    "uid": "aiops-logs",
    "tags": ["aiops", "logs"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Total Logs",
        "type": "stat",
        "targets": [
          {
            "expr": "count_over_time(logs_total[1h])",
            "legendFormat": "Total Logs"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Error Logs",
        "type": "stat",
        "targets": [
          {
            "expr": "count_over_time(logs_error_total[1h])",
            "legendFormat": "Error Logs"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Critical Logs",
        "type": "stat",
        "targets": [
          {
            "expr": "count_over_time(logs_critical_total[1h])",
            "legendFormat": "Critical Logs"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Average Response Time",
        "type": "stat",
        "targets": [
          {
            "expr": "avg(logs_response_time)",
            "legendFormat": "Avg Response Time"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "Log Volume Over Time",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(logs_total[5m])",
            "legendFormat": "Logs/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
      },
      {
        "id": 6,
        "title": "Log Levels Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (level) (logs_total)",
            "legendFormat": "{{level}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
      },
      {
        "id": 7,
        "title": "Error Rate Trend",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(logs_error_total[5m])",
            "legendFormat": "Error Rate"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
      },
      {
        "id": 8,
        "title": "Top Error Modules",
        "type": "bargauge",
        "targets": [
          {
            "expr": "topk(10, sum by (logger) (logs_error_total))",
            "legendFormat": "{{logger}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
      },
      {
        "id": 9,
        "title": "Log Sources",
        "type": "table",
        "targets": [
          {
            "expr": "sum by (hostname, environment) (logs_total)",
            "format": "table"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20}
      }
    ]
  }
}
