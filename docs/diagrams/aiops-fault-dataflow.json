  "cards": [
    {
      "dot": "cyan",
      "title": "Detect & Ingest",
      "items": [
        "Prometheus Alertmanager sends the firing alert as a webhook",
        "Gateway normalizes the alert and observability provides context"
      ]
    },
    {
      "dot": "emerald",
      "title": "Analyze & Plan",
      "items": [
        "Alert engine enriches the alert with metrics and logs",
        "AI/router picks a root cause and runbook; HITL approval is required"
      ]
    },
    {
      "dot": "rose",
      "title": "Execute & Audit",
      "items": [
        "Approved commands run dry-run or apply through the executor",
        "Every remediation action and result is persisted to PostgreSQL"
      ]
