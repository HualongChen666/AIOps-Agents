# E2E Tests Configuration
# E2E测试环境配置文件

# E2E测试环境变量
E2E_BASE_URL=http://localhost:8000
E2E_APP_PORT=8000
E2E_DATABASE_URL=postgresql://testuser:testpass@localhost:5432/test_db
E2E_REDIS_URL=redis://localhost:6379/1
E2E_QDRANT_URL=http://localhost:6333

# 测试超时设置
E2E_REQUEST_TIMEOUT=30
E2E_OPERATION_TIMEOUT=60
E2E_TEST_TIMEOUT=300

# 测试数据配置
E2E_TEST_DATA_PREFIX=e2e_test_
E2E_CLEANUP_AFTER_TEST=true
E2E_ISOLATE_TEST_DATA=true

# 并行测试配置
E2E_PARALLEL_ENABLED=false
E2E_MAX_WORKERS=4

# 日志配置
E2E_LOG_LEVEL=INFO
E2E_LOG_FILE=e2e_test.log