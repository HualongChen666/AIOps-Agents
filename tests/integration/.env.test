# Integration Tests Configuration
# 集成测试环境配置文件

# =============================
# 基础配置
# =============================

# 测试环境标识
ENVIRONMENT=test
TESTING=true

# =============================
# 数据库配置
# =============================

# 测试数据库配置
DATABASE_URL=postgresql://testuser:testpass@localhost:5432/test_db
DATABASE_TEST_URL=postgresql://testuser:testpass@localhost:5432/test_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# 测试数据库连接池配置
DATABASE_ECHO=false
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_RECYCLE=3600

# =============================
# Redis配置
# =============================

# 测试Redis配置
REDIS_URL=redis://localhost:6379/1
REDIS_TEST_DB=1
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# =============================
# Qdrant配置（向量数据库）
# =============================

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TEST_COLLECTION=test_collection

# =============================
# API配置
# =============================

# 测试API配置
API_HOST=localhost
API_PORT=8000
API_BASE_URL=http://localhost:8000
API_TEST_TIMEOUT=30

# =============================
# 认证配置
# =============================

# 测试认证配置
JWT_SECRET_KEY=test_secret_key_for_testing_only
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# 测试用户配置
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=admin123
TEST_USER_USERNAME=testuser
TEST_USER_PASSWORD=testpass123

# =============================
# 缓存配置
# =============================

# 测试缓存配置
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# =============================
# 日志配置
# =============================

# 测试日志配置
LOG_LEVEL=DEBUG
LOG_FILE=logs/test_integration.log
LOG_FORMAT=%(asctime)s [%(levelname)8s] %(name)s: %(message)s

# =============================
# 测试执行配置
# =============================

# 测试超时配置
TEST_TIMEOUT=30
TEST_REQUEST_TIMEOUT=10
TEST_OPERATION_TIMEOUT=60

# 测试数据配置
TEST_DATA_PREFIX=test_
CLEANUP_AFTER_TEST=true
ISOLATE_TEST_DATA=true

# 并行测试配置
PARALLEL_ENABLED=false
MAX_WORKERS=4

# =============================
# 外部服务Mock配置
# =============================

# AI服务Mock配置
AI_ENABLED=true
AI_API_KEY=test_api_key
AI_BASE_URL=http://localhost:8000/mock/ai
AI_MODEL=test-model
AI_MOCK_ENABLED=true

# 告警服务Mock配置
ALERT_SERVICE_MOCK_ENABLED=true
ALERT_SERVICE_BASE_URL=http://localhost:8000/mock/alerts

# 监控服务Mock配置
MONITORING_SERVICE_MOCK_ENABLED=true
MONITORING_SERVICE_BASE_URL=http://localhost:8000/mock/monitoring

# =============================
# 安全配置（测试环境）
# =============================

# 测试安全配置
SECURITY_ENABLED=true
ENCRYPTION_KEY=test_encryption_key_32_bytes_long
RATE_LIMIT_ENABLED=false
CORS_ENABLED=true
CORS_ORIGINS=*

# =============================
# 性能测试配置
# =============================

# 性能测试配置
PERFORMANCE_TEST_ENABLED=false
PERFORMANCE_TEST_DURATION=60
PERFORMANCE_TEST_CONCURRENT_USERS=10
