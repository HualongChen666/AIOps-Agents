{
  "mcpServers": {
    "gitlab": {
      "command": "C:\\Program Files\\Python312\\python.exe",
      "args": [
        "C:\\Users\\Hualong_Chen\\AppData\\Roaming\\devin\\mcp-gitlab-launcher.py"
      ],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "",
        "GITLAB_API_URL": "https://gitlab.dell.com/api/v4"
      }
    },
    "filesystem": {
      "command": "C:\\Program Files\\nodejs\\npx.CMD",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\AIOps_Agent_bak"
      ],
      "env": {}
    },
    "postgres": {
      "command": "C:\\Program Files\\nodejs\\npx.CMD",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost:5432/aiops"
      ],
      "env": {}
    }
  },
  "project": {
    "name": "AIOps Agent",
    "directory": "C:\\AIOps_Agent_bak",
    "language": "python",
    "framework": "fastapi"
  },
  "security": {
    "gitlab_upload_control": {
      "enabled": true,
      "deny_all_uploads_without_command": true,
      "allowed_command_pattern": "将某一个目录(含目录中的子目录和文件)或者某一个/几个文件(具体文件名)上传到我的gitlab中"
    }
  },
  "permissions": {
    "allow": [
      "mcp__gitlab__read_*",
      "mcp__gitlab__search_*",
      "mcp__filesystem__read_*",
      "mcp__filesystem__list_*",
      "mcp__filesystem__directory_tree",
      "mcp__filesystem__search_files",
      "mcp__filesystem__get_file_info",
      "mcp__postgres__read_query",
      "mcp__github__read_*",
      "mcp__github__search_*",
      "mcp__github__get_*",
      "mcp__git__status",
      "mcp__git__log",
      "mcp__git__diff",
      "mcp__git__branch",
      "mcp__memory__read_*",
      "mcp__memory__get_*",
      "mcp__memory__search_*"
    ],
    "ask": [
      "mcp__gitlab__write_*",
      "mcp__gitlab__push",
      "mcp__gitlab__commit",
      "mcp__gitlab__upload",
      "mcp__postgres__write_query",
      "mcp__postgres__execute_sql",
      "mcp__github__write_*",
      "mcp__github__create_*",
      "mcp__github__update_*",
      "mcp__github__delete_*",
      "mcp__github__push",
      "mcp__github__commit",
      "mcp__github__pull_request",
      "mcp__git__commit",
      "mcp__git__push",
      "mcp__git__checkout",
      "mcp__git__reset",
      "mcp__git__add",
      "mcp__git__merge",
      "mcp__git__rebase",
      "mcp__brave-search__*",
      "mcp__memory__write_*",
      "mcp__memory__add_*",
      "mcp__memory__delete_*",
      "mcp__memory__update_*"
    ],
    "deny": [
      "mcp__filesystem__write_*",
      "mcp__filesystem__edit_*",
      "mcp__filesystem__delete_*",
      "mcp__filesystem__create_*",
      "mcp__filesystem__move_*",
      "mcp__gitlab__push_without_command",
      "mcp__gitlab__upload_without_command",
      "mcp__github__push_without_command",
      "mcp__github__upload_without_command",
      "mcp__github__delete_repository",
      "mcp__git__push_without_command",
      "mcp__git__force_*",
      "mcp__postgres__drop_*",
      "mcp__postgres__truncate_*"
    ]
  }
}