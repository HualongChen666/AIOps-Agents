# 行为监控配置 - 开发环境
# Behavior Monitor Configuration - Development Environment

# 超时配置
SUBAGENT_TIMEOUT_SECONDS=60
SUBAGENT_STALL_TIMEOUT_SECONDS=120
API_TIMEOUT_MS=120000

# 并发配置
MAX_CONCURRENT_SUBAGENTS=5
MAX_CONCURRENT_TOOL_EXECUTIONS=10

# 功能开关
ENABLE_TIMEOUT=true
ENABLE_VALIDATION=true
ENABLE_WHITELIST=true
ENABLE_PROGRESS=false
ENABLE_STALL_DETECTION=false

# 工具白名单
ALLOWED_TOOLS=bash,read_file,write_to_file,edit

# 原有配置保留
BEHAVIOR_MONITOR_MAX_AGENTS=20
BEHAVIOR_MONITOR_TTL_DAYS=1
BEHAVIOR_MONITOR_CLEANUP_INTERVAL=1800
BEHAVIOR_MONITOR_MIN_SAMPLES=5
BEHAVIOR_MONITOR_TIME_WINDOW_DAYS=0