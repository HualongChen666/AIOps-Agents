{
  "policies": [
    {
      "name": "alert_delete_policy",
      "description": "Allow operators and admins to delete alerts",
      "effect": "allow",
      "subject_conditions": {
        "role": {
          "in": [
            "operator",
            "admin"
          ]
        },
        "clearance_level": {
          "gte": 2
        }
      },
      "resource_conditions": {
        "type": {
          "equals": "alert"
        }
      },
      "environment_conditions": {
        "time": {
          "regex": ".*"
        }
      },
      "actions": [
        "delete"
      ],
      "priority": 100
    },
    {
      "name": "auto_heal_execute_policy",
