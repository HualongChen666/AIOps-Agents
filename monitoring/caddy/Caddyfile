:80 {
    # Prometheus
    handle /prometheus* {
        reverse_proxy prometheus:9090
    }
    
    # Grafana
    handle /grafana* {
        reverse_proxy grafana:3000
    }
    
    # Alertmanager
    handle /alertmanager* {
        reverse_proxy alertmanager:9093
    }
    
    # Default - redirect to Grafana
    handle {
        reverse_proxy grafana:3000
    }
}
