{
  "dashboard": {
    "title": "AIOps Anomaly Detection Dashboard",
    "uid": "anomaly-detection",
    "tags": ["aiops", "anomaly", "detection"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Anomaly Detection Recall Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "aiops_anomaly_recall_rate",
            "legendFormat": "Recall"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 90},
                {"color": "green", "value": 95}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Anomaly False Positive Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "aiops_anomaly_false_positive_rate",
            "legendFormat": "False Positive"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 3},
                {"color": "red", "value": 5}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Total Anomalies Detected",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(aiops_anomalies_detected_total[1h]))",
            "legendFormat": "Total"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 100}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Anomaly Severity Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (severity) (aiops_anomalies_detected_total)",
            "legendFormat": "{{severity}}"
          }
        ]
      },
      {
        "id": 5,
        "title": "Anomalies by Service",
        "type": "barchart",
        "targets": [
          {
            "expr": "topk(10, sum by (service) (aiops_anomalies_detected_total))",
            "legendFormat": "{{service}}"
          }
        ]
      },
      {
        "id": 6,
        "title": "Anomaly Detection Over Time",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(aiops_anomalies_detected_total[5m]))",
            "legendFormat": "Detection Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        }
      },
      {
        "id": 7,
        "title": "Model Performance Comparison",
        "type": "graph",
        "targets": [
          {
            "expr": "aiops_model_accuracy{model_type=\"prophet\"}",
            "legendFormat": "Prophet"
          },
          {
            "expr": "aiops_model_accuracy{model_type=\"isolation_forest\"}",
            "legendFormat": "Isolation Forest"
          },
          {
            "expr": "aiops_model_accuracy{model_type=\"ensemble\"}",
            "legendFormat": "Ensemble"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      },
      {
        "id": 8,
        "title": "Anomaly Response Time",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(aiops_anomaly_detection_duration_seconds_bucket[5m]))",
            "legendFormat": "P95 Detection Time"
          },
          {
            "expr": "histogram_quantile(0.50, rate(aiops_anomaly_detection_duration_seconds_bucket[5m]))",
            "legendFormat": "P50 Detection Time"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 9,
        "title": "Root Cause Analysis Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "aiops_root_cause_success_rate",
            "legendFormat": "Success Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 80},
                {"color": "green", "value": 90}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Auto-Heal Trigger Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(auto_heal_triggered_total[5m]))",
            "legendFormat": "Auto-Heal Triggers"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        }
      },
      {
        "id": 11,
        "title": "Recent Anomalies Table",
        "type": "table",
        "targets": [
          {
            "expr": "aiops_recent_anomalies",
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true
              },
              "indexByName": {},
              "renameByName": {
                "service": "Service",
                "severity": "Severity",
                "anomaly_type": "Type",
                "description": "Description",
                "timestamp": "Time"
              }
            }
          }
        ]
      },
      {
        "id": 12,
        "title": "Anomaly Heatmap by Service and Type",
        "type": "heatmap",
        "targets": [
          {
            "expr": "sum by (service, anomaly_type) (aiops_anomalies_detected_total)",
            "legendFormat": "{{service}} - {{anomaly_type}}"
          }
        ]
      },
      {
        "id": 13,
        "title": "MTTR for Anomalies",
        "type": "stat",
        "targets": [
          {
            "expr": "aiops_anomaly_mttr_minutes",
            "legendFormat": "MTTR"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "m",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 20},
                {"color": "red", "value": 30}
              ]
            }
          }
        }
      },
      {
        "id": 14,
        "title": "False Negative Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "aiops_anomaly_false_negative_rate",
            "legendFormat": "False Negative"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 10}
              ]
            }
          }
        }
      },
      {
        "id": 15,
        "title": "Anomaly Trend Analysis",
        "type": "graph",
        "targets": [
          {
            "expr": "predict_linear(aiops_anomalies_detected_total[1h], 3600)",
            "legendFormat": "Predicted Trend"
          },
          {
            "expr": "aiops_anomalies_detected_total",
            "legendFormat": "Actual"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      }
    ]
  }
}
