# AIOps SRE Agent environment configuration template.
# Copy this file to `.env` and fill in real values before running in production.

# ---------------------------------------------------------------------------
# AI / LLM providers (at least one is required for analysis; fallback to rule
# engine works when all are absent, but responses will be degraded).
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# ---------------------------------------------------------------------------
# Data stores (PostgreSQL/Redis are required for full persistence; empty values
# fall back to in-memory/disk fallbacks suitable for local demo).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://aiops:aiops@localhost:5432/aiops
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auto-heal execution safety flags
# ---------------------------------------------------------------------------
# Allow the heal_graph to execute low/safe software repair commands automatically.
HEAL_AUTO_APPROVE_SAFE_LOW=false
# Allow real command execution at all. Default false = dry-run.
HEAL_EXECUTE_ENABLED=false
# Force dry-run even when HEAL_EXECUTE_ENABLED is true.
HEAL_DRY_RUN=true
# Allow real hardware (IPMI/Redfish/RAID/SMART/K8s) remediation. Must stay
# false until you have reviewed the generated runbooks and approval workflow.
HARDWARE_EXECUTE_ENABLED=false

# ---------------------------------------------------------------------------
# ABAC / security
# ---------------------------------------------------------------------------
AIOPS_ENFORCE_ABAC=false
SNAPSHOT_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Logging / environment
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development

# Add-ons master switch
ENABLE_ADDONS=false

# Individual add-on packs (only honored when ENABLE_ADDONS=true)
RAG_ENABLED=false
LLM_ROUTER_ENABLED=false
TOPOLOGY_ENABLED=false
TRACING_ENABLED=false
LOG_AGGREGATION_ENABLED=false
INCIDENT_RESPONSE_ENABLED=false
WORKFLOW_ENABLED=false
INTEGRATIONS_ENABLED=false
SECURITY_SCANNING_ENABLED=false
PENETRATION_TESTING_ENABLED=false
PLUGINS_ENABLED=false
SHARDING_ENABLED=false
I18N_ENABLED=false
DOC_GENERATION_ENABLED=false

# Add-on remote microservice URLs (only used when MICROSERVICE_MODE=remote)
RAG_SERVICE_URL=http://rag-service:8000
LLM_ROUTER_SERVICE_URL=http://llm-router-service:8000
TOPOLOGY_SERVICE_URL=http://topology-service:8000
INCIDENT_RESPONSE_SERVICE_URL=http://incident-response-service:8000
