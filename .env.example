# AIOps SRE Agent environment configuration template.
# Copy this file to `.env` and fill in real values before running in production.

# ---------------------------------------------------------------------------
# AI / LLM providers (at least one is required for analysis; fallback to rule
# engine works when all are absent, but responses will be degraded).
# ---------------------------------------------------------------------------
AI_API_KEY=your_minimax_api_key_here
AI_BASE_URL=https://api.minimaxi.com/v1
AI_MODEL=MiniMax-Text-01
AI_ENABLED=false
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# ---------------------------------------------------------------------------
# Data stores (PostgreSQL/Redis are required for full persistence; empty values
# fall back to in-memory/disk fallbacks suitable for local demo).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://aiops:aiops@localhost:5432/aiops
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auto-heal execution safety flags
# ---------------------------------------------------------------------------
# Allow the heal_graph to execute low/safe software repair commands automatically.
HEAL_AUTO_APPROVE_SAFE_LOW=false
# Allow real command execution at all. Default false = dry-run.
HEAL_EXECUTE_ENABLED=false
# Force dry-run even when HEAL_EXECUTE_ENABLED is true.
HEAL_DRY_RUN=true
# Allow real hardware (IPMI/Redfish/RAID/SMART/K8s) remediation. Must stay
# false until you have reviewed the generated runbooks and approval workflow.
HARDWARE_EXECUTE_ENABLED=false

# ---------------------------------------------------------------------------
# ABAC / security
# ---------------------------------------------------------------------------
AIOPS_ENFORCE_ABAC=false
SNAPSHOT_ENCRYPTION_KEY=
INTERNAL_API_KEY=your_internal_api_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars
POSTGRES_PASSWORD=your_postgres_password_here
REDIS_PASSWORD=your_redis_password_here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Vulnerability Intelligence
# ---------------------------------------------------------------------------
NVD_API_KEY=your_nvd_api_key_here

# ---------------------------------------------------------------------------
# Langfuse (LLM Observability)
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key

# ---------------------------------------------------------------------------
# Integration Credentials
# ---------------------------------------------------------------------------
SERVICENOW_INSTANCE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
TEAMS_WEBHOOK=

# ---------------------------------------------------------------------------
# External Service URLs
# ---------------------------------------------------------------------------
# Base URL for SLO Advanced API (used in examples)
SLO_API_BASE_URL=http://localhost:8000
# Prometheus URL for metrics collection (used in anomaly detection)
PROMETHEUS_URL=http://localhost:9090

# ---------------------------------------------------------------------------
# Storage Driver Configuration
# ---------------------------------------------------------------------------
# Redis URL for storage driver (used in addons)
STORAGE_REDIS_URL=redis://localhost:6379
# Database URL for storage driver (used in addons)
STORAGE_DATABASE_URL=postgresql://localhost:5432/postgres
# Qdrant URL for vector storage (used in addons)
STORAGE_QDRANT_URL=http://localhost:6333

# ---------------------------------------------------------------------------
# Plugin Marketplace Security
# ---------------------------------------------------------------------------
# Private key for signing plugins (HMAC-based signature)
PLUGIN_MARKETPLACE_PRIVATE_KEY=
# Public key for verifying plugin signatures
PLUGIN_MARKETPLACE_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Logging / environment
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development

# Add-ons master switch
ENABLE_ADDONS=false

# Individual add-on packs (only honored when ENABLE_ADDONS=true)
RAG_ENABLED=false
LLM_ROUTER_ENABLED=false
TOPOLOGY_ENABLED=false
TRACING_ENABLED=false
LOG_AGGREGATION_ENABLED=false
INCIDENT_RESPONSE_ENABLED=false
WORKFLOW_ENABLED=false
INTEGRATIONS_ENABLED=false
SECURITY_SCANNING_ENABLED=false
PENETRATION_TESTING_ENABLED=false
PLUGINS_ENABLED=false
SHARDING_ENABLED=false
I18N_ENABLED=false
DOC_GENERATION_ENABLED=false

# Add-on remote microservice URLs (only used when MICROSERVICE_MODE=remote)
RAG_SERVICE_URL=http://rag-service:8000
LLM_ROUTER_SERVICE_URL=http://llm-router-service:8000
TOPOLOGY_SERVICE_URL=http://topology-service:8000
INCIDENT_RESPONSE_SERVICE_URL=http://incident-response-service:8000
